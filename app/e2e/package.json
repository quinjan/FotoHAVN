{
  "name": "fotohavn-e2e",
  "version": "0.0.0",
  "private": true,
  "description": "End-to-end tests that drive the real FOTOHAVN desktop app (E2E build) with a real camera.",
  "type": "module",
  "engines": {
    "node": ">=24.19.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test:smoke": "playwright test --project=smoke",
    "test:regression": "playwright test --project=regression"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "24.19.2",
    "@types/pngjs": "6.0.5",
    "jpeg-js": "0.4.4",
    "pixelmatch": "8.0.0",
    "pngjs": "7.0.0",
    "typescript": "5.9.3"
  }
}
