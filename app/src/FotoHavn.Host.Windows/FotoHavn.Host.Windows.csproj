<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>$(FotoHavnWindowsTargetFramework)</TargetFramework>
    <SupportedOSPlatformVersion>$(FotoHavnWindowsMinimumVersion)</SupportedOSPlatformVersion>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <UseWPF>true</UseWPF>
    <AssemblyName>FOTOHAVN</AssemblyName>
    <RootNamespace>FotoHavn.Host.Windows</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Web.WebView2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FotoHavn.Camera.Windows\FotoHavn.Camera.Windows.csproj" />
    <ProjectReference Include="..\FotoHavn.Catalog\FotoHavn.Catalog.csproj" />
    <ProjectReference Include="..\FotoHavn.Core\FotoHavn.Core.csproj" />
    <ProjectReference Include="..\FotoHavn.Protocol\FotoHavn.Protocol.csproj" />
    <ProjectReference Include="..\FotoHavn.Storage\FotoHavn.Storage.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FotoHavn.Host.Windows.Tests" />
  </ItemGroup>

  <!--
    The built React UI ships as wwwroot/ beside FOTOHAVN.exe when it exists: ui/dist for field builds, and ui/dist-e2e
    (written by `npm run build:e2e`) for hook builds. Only the E2E UI build writes e2e-build.txt.
  -->
  <PropertyGroup>
    <FotoHavnUiDist Condition="'$(FotoHavnE2EHooks)' == 'true'">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\ui\dist-e2e'))</FotoHavnUiDist>
    <FotoHavnUiDist Condition="'$(FotoHavnE2EHooks)' != 'true'">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\ui\dist'))</FotoHavnUiDist>
    <FotoHavnE2EUiMarker>e2e-build.txt</FotoHavnE2EUiMarker>
  </PropertyGroup>
  <ItemGroup Condition="Exists('$(FotoHavnUiDist)')">
    <Content Include="$(FotoHavnUiDist)\**\*"
             LinkBase="wwwroot"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- A field build refuses a ui/dist that holds an E2E UI build. -->
  <Target Name="FotoHavnRefuseE2EUi"
          BeforeTargets="CopyFilesToOutputDirectory"
          Condition="'$(FotoHavnE2EHooks)' != 'true' and Exists('$(FotoHavnUiDist)\$(FotoHavnE2EUiMarker)')">
    <Error Code="FOTOHAVN0003"
           Text="$(FotoHavnPublishGuardText) $(FotoHavnUiDist) holds an E2E UI build ($(FotoHavnE2EUiMarker)). Run `npm run build` in ui/." />
  </Target>

  <!--
    Vite names assets by content hash, so each UI build leaves the previous copy's files behind in wwwroot/.
    Before copying, delete every file in <OutDir>/wwwroot that the UI folder no longer has (all of them when it's missing).
  -->
  <Target Name="FotoHavnRemoveStaleWwwroot" BeforeTargets="CopyFilesToOutputDirectory">
    <ItemGroup>
      <_FotoHavnUiDistFile Include="$(FotoHavnUiDist)\**\*" Condition="Exists('$(FotoHavnUiDist)')" />
      <_FotoHavnStaleWwwrootFile Include="$(OutDir)wwwroot\**\*" />
      <_FotoHavnStaleWwwrootFile Remove="@(_FotoHavnUiDistFile->'$(OutDir)wwwroot\%(RecursiveDir)%(Filename)%(Extension)')" />
    </ItemGroup>
    <Delete Files="@(_FotoHavnStaleWwwrootFile)" />
  </Target>

  <!-- The publish guard for every project is in Directory.Build.targets. -->
</Project>
