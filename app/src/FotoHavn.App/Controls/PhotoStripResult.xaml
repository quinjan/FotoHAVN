<UserControl
    x:Class="FotoHavn.App.Controls.PhotoStripResult"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    AutomationProperties.AutomationId="FotoHavn.PhotoStripResult"
    AutomationProperties.Name="Photo Strip result"
    Style="{StaticResource FotoHavnPhotoStripResultStyle}">
    <Grid x:Name="LayoutRoot" ColumnSpacing="{StaticResource PhotoStripResultColumnSpacing}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="MessageColumn" Width="*" />
            <ColumnDefinition x:Name="PreviewColumn" Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel x:Name="MessagePanel" VerticalAlignment="Center" Style="{StaticResource FotoHavnPhotoStripMessagePanelStyle}">
            <TextBlock x:Name="EyebrowText" Style="{StaticResource TypeEyebrowStyle}" Text="ALL FOUR CAPTURES SAVED" />
            <TextBlock
                x:Name="TitleText"
                AutomationProperties.HeadingLevel="Level1"
                Style="{StaticResource FotoHavnPhotoStripTitleStyle}"
                Text="{x:Bind Title, Mode=OneWay}" />
            <TextBlock
                x:Name="PhotoStripPreviewSemantic"
                AutomationProperties.Name="Photo Strip preview"
                Style="{StaticResource FotoHavnSemanticAnchorStyle}" />
            <TextBlock
                x:Name="MessageText"
                Foreground="{ThemeResource ColorTextMutedBrush}"
                Style="{StaticResource FotoHavnPhotoStripMessageStyle}"
                Text="{x:Bind Message, Mode=OneWay}" />
            <ProgressBar
                x:Name="ReturnProgressBar"
                AutomationProperties.AutomationId="FotoHavn.PhotoStripResult.ReturnProgress"
                AutomationProperties.Name="return status and progress"
                Maximum="1"
                Style="{StaticResource FotoHavnPhotoStripReturnProgressStyle}"
                Value="{x:Bind ReturnProgress, Mode=OneWay}" />
            <TextBlock
                x:Name="FailureText"
                AutomationProperties.LiveSetting="Assertive"
                Foreground="{ThemeResource ColorStatusDangerForegroundBrush}"
                Style="{StaticResource FotoHavnPhotoStripFailureStyle}"
                Text="The Photo Strip could not be displayed. Please call the operator."
                Visibility="Collapsed" />
        </StackPanel>
        <Border x:Name="PreviewFrame" Grid.Column="1" Style="{StaticResource FotoHavnPhotoStripPreviewFrameStyle}">
            <Grid>
                <Image
                    x:Name="PreviewImage"
                    AutomationProperties.AccessibilityView="Raw"
                    Source="{x:Bind ImageSource, Mode=OneWay}"
                    Stretch="Uniform" />
                <ProgressRing
                    x:Name="PreparingProgress"
                    AutomationProperties.AutomationId="FotoHavn.PhotoStripResult.Preparing"
                    AutomationProperties.Name="Preparing Photo Strip"
                    IsActive="True" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
