<UserControl
    x:Class="FotoHavn.App.Controls.SetupFieldGroup"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:FotoHavn.App.Controls"
    AutomationProperties.AutomationId="FotoHavn.SetupFieldGroup"
    Style="{StaticResource FotoHavnSetupFieldGroupStyle}">
    <StackPanel Spacing="{StaticResource SpaceStackTight}">
        <TextBlock
            x:Name="LabelText"
            Style="{StaticResource TypeLabelControlStyle}"
            Text="{x:Bind Label, Mode=OneWay}" />
        <Grid>
            <ContentPresenter Content="{x:Bind FieldContent, Mode=OneWay}" />
            <Border
                x:Name="DirtyIndicator"
                HorizontalAlignment="Left"
                Background="{ThemeResource ColorFocusRingBrush}"
                IsHitTestVisible="False"
                Style="{StaticResource FotoHavnDirtyIndicatorStyle}"
                Visibility="Collapsed" />
        </Grid>
        <ContentPresenter x:Name="HelperHost" Content="{x:Bind HelperContent, Mode=OneWay}" />
        <controls:InlineStatus
            x:Name="StatusHost"
            Style="{StaticResource FotoHavnInlineStatusStyle}"
            Visibility="Collapsed" />
    </StackPanel>
</UserControl>
