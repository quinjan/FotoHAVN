<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <MSBuildTreatWarningsAsErrors>true</MSBuildTreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Deterministic>true</Deterministic>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <!-- Restore is reproducible: every project commits packages.lock.json, and CI restores with locked mode. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>

    <Company>FOTOHAVN</Company>
    <Product>FOTOHAVN</Product>
    <Copyright>FOTOHAVN</Copyright>
  </PropertyGroup>

  <!-- Windows projects (camera adapter, WPF host, and their tests) share one TFM and run x64 only. -->
  <PropertyGroup>
    <FotoHavnWindowsTargetFramework>net10.0-windows10.0.26100.0</FotoHavnWindowsTargetFramework>
    <FotoHavnWindowsMinimumVersion>10.0.19041.0</FotoHavnWindowsMinimumVersion>
  </PropertyGroup>

  <!--
    Projects that ship inside FOTOHAVN.exe also restore for win-x64, so packages.lock.json already holds the graph that
    the self-contained `-r win-x64` field publish needs and the publish leaves the lock files unchanged.
  -->
  <PropertyGroup Condition="!$(MSBuildProjectName.EndsWith('.Tests')) and '$(MSBuildProjectName)' != 'FotoHavn.Host.Headless'">
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <!--
    E2E build switch: `dotnet build -p:FotoHavnE2E=true` compiles the test hooks into every project.
    Field builds never set it; the publish guards in Directory.Build.targets refuse any publish that carries hooks.
  -->
  <PropertyGroup Condition="'$(FotoHavnE2E)' == 'true'">
    <DefineConstants>$(DefineConstants);E2E_HOOKS</DefineConstants>
  </PropertyGroup>

  <!--
    A build has hooks when FotoHavnE2E is set or E2E_HOOKS is defined directly (for example -p:DefineConstants=E2E_HOOKS).
    Directory.Build.targets re-checks it after the project file, which could also add the constant.
  -->
  <PropertyGroup>
    <FotoHavnE2EHooks>false</FotoHavnE2EHooks>
    <FotoHavnE2EHooks Condition="$([System.String]::Copy(';$(DefineConstants);').Replace(' ', '').Contains(';E2E_HOOKS;'))">true</FotoHavnE2EHooks>
  </PropertyGroup>

  <!--
    Hook builds compile, restore, and output into their own folders (obj/e2e/, bin/e2e/), so a later normal build, test
    run, or publish without a build never picks up an assembly compiled with the hooks. The base paths must be set here,
    before the SDK reads them. Each build excludes both trees from its default items, so neither compiles the other's
    generated sources.
  -->
  <PropertyGroup Condition="'$(FotoHavnE2EHooks)' == 'true'">
    <BaseIntermediateOutputPath>obj\e2e\</BaseIntermediateOutputPath>
    <BaseOutputPath>bin\e2e\</BaseOutputPath>
  </PropertyGroup>
  <PropertyGroup>
    <DefaultItemExcludes>$(DefaultItemExcludes);obj\**;bin\**</DefaultItemExcludes>
  </PropertyGroup>

  <!-- Test projects: xUnit v3 on Microsoft.Testing.Platform, with Microsoft code coverage. -->
  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('.Tests'))">
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- CA1707: test names use underscores as sentences (Name_is_the_brain_assembly). -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>
  <ItemGroup Condition="$(MSBuildProjectName.EndsWith('.Tests'))">
    <PackageReference Include="xunit.v3.mtp-v2" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
