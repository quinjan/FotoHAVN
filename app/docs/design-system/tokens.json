    "fast": { "$type": "duration", "$value": "{primitive.duration.fast}" },
    "standard": { "$type": "duration", "$value": "{primitive.duration.standard}" },
    "slow": { "$type": "duration", "$value": "{primitive.duration.slow}" },
    "easing": { "$type": "cubicBezier", "$value": [0.0, 0.0, 0.2, 1.0] }
