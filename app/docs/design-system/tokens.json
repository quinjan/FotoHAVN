  "elevation": {
    "routine": { "$type": "shadow", "$value": { "color": "rgba(23, 24, 26, 0)", "offsetX": "0px", "offsetY": "0px", "blur": "0px", "spread": "0px" } },
    "dialog": { "$type": "shadow", "$value": { "color": "rgba(23, 24, 26, 0.16)", "offsetX": "0px", "offsetY": "8px", "blur": "24px", "spread": "0px" } }
