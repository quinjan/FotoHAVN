{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "color": {
    "warm-ivory": {
      "$value": "#F3EBDD",
      "$type": "color",
      "$description": "Primary warm editorial surface"
    },
    "cream-paper": {
      "$value": "#E8DDCE",
      "$type": "color",
      "$description": "Secondary section and photographic mat surface"
    },
    "off-white": {
      "$value": "#FBF8F2",
      "$type": "color",
      "$description": "Main canvas and inverse text"
    },
    "ebony": {
      "$value": "#1E1A17",
      "$type": "color",
      "$description": "Primary text and highest-emphasis action"
    },
    "dark-walnut": {
      "$value": "#2D211B",
      "$type": "color",
      "$description": "Controlled dark surface and action hover"
    },
    "soft-brown": {
      "$value": "#756457",
      "$type": "color",
      "$description": "Secondary text and quiet labels"
    },
    "muted-brass": {
      "$value": "#9A7A4F",
      "$type": "color",
      "$description": "Selected states, rules, and restrained brand detail"
    },
    "antique-metal": {
      "$value": "#B39A78",
      "$type": "color",
      "$description": "Muted detail on dark surfaces"
    },
    "hairline": {
      "$value": "#D1C4B4",
      "$type": "color",
      "$description": "Borders, dividers, and image frames"
    },
    "text": {
      "primary": {
        "$value": "{color.ebony}",
        "$type": "color",
        "$description": "Default text on light surfaces"
      },
      "secondary": {
        "$value": "{color.soft-brown}",
        "$type": "color",
        "$description": "Supporting text on light surfaces"
      },
      "inverse": {
        "$value": "{color.off-white}",
        "$type": "color",
        "$description": "Primary text on dark surfaces"
      },
      "inverse-muted": {
        "$value": "{color.antique-metal}",
        "$type": "color",
        "$description": "Supporting text on dark surfaces"
      }
    },
    "action": {
      "primary": {
        "$value": "{color.ebony}",
        "$type": "color",
        "$description": "Primary action background"
      },
      "primary-hover": {
        "$value": "{color.dark-walnut}",
        "$type": "color",
        "$description": "Primary action hover background"
      },
      "accent": {
        "$value": "{color.muted-brass}",
        "$type": "color",
        "$description": "Selected tab rule and restrained accent"
      }
    }
  },
  "surface": {
    "canvas": {
      "$value": "{color.off-white}",
      "$type": "color",
      "$description": "Primary page canvas"
    },
    "editorial": {
      "$value": "{color.warm-ivory}",
      "$type": "color",
      "$description": "Soft editorial section"
    },
    "paper": {
      "$value": "{color.cream-paper}",
      "$type": "color",
      "$description": "Photo mat and quiet inset surface"
    },
    "dark": {
      "$value": "{color.dark-walnut}",
      "$type": "color",
      "$description": "One intentional dark content band"
    },
    "deep": {
      "$value": "{color.ebony}",
      "$type": "color",
      "$description": "Footer and highest-emphasis detail"
    }
  },
  "font": {
    "display": {
      "$value": "Cormorant Garamond",
      "$type": "fontFamily",
      "$description": "Editorial serif for major headings and price"
    },
    "sans": {
      "$value": "Manrope",
      "$type": "fontFamily",
      "$description": "Modern sans-serif for body and interface text"
    }
  },
  "font-weight": {
    "regular": {
      "$value": 400,
      "$type": "fontWeight"
    },
    "medium": {
      "$value": 500,
      "$type": "fontWeight"
    },
    "semibold": {
      "$value": 600,
      "$type": "fontWeight"
    }
  },
  "typography": {
    "label": {
      "$value": {
        "fontFamily": "{font.sans}",
        "fontSize": "12px",
        "fontWeight": "{font-weight.semibold}",
        "letterSpacing": "0.18em",
        "lineHeight": 1.2
      },
      "$type": "typography",
      "$description": "Uppercase eyebrow and section label"
    },
    "body-sm": {
      "$value": {
        "fontFamily": "{font.sans}",
        "fontSize": "14px",
        "fontWeight": "{font-weight.regular}",
        "letterSpacing": "0em",
        "lineHeight": 1.55
      },
      "$type": "typography"
    },
    "body": {
      "$value": {
        "fontFamily": "{font.sans}",
        "fontSize": "16px",
        "fontWeight": "{font-weight.regular}",
        "letterSpacing": "0em",
        "lineHeight": 1.65
      },
      "$type": "typography"
    },
    "body-lg": {
      "$value": {
        "fontFamily": "{font.sans}",
        "fontSize": "20px",
        "fontWeight": "{font-weight.regular}",
        "letterSpacing": "-0.01em",
        "lineHeight": 1.5
      },
      "$type": "typography"
    },
    "subheading": {
      "$value": {
        "fontFamily": "{font.display}",
        "fontSize": "28px",
        "fontWeight": "{font-weight.medium}",
        "letterSpacing": "-0.015em",
        "lineHeight": 1.2
      },
      "$type": "typography"
    },
    "heading-sm": {
      "$value": {
        "fontFamily": "{font.display}",
        "fontSize": "36px",
        "fontWeight": "{font-weight.medium}",
        "letterSpacing": "-0.02em",
        "lineHeight": 1.08
      },
      "$type": "typography"
    },
    "heading": {
      "$value": {
        "fontFamily": "{font.display}",
        "fontSize": "52px",
        "fontWeight": "{font-weight.medium}",
        "letterSpacing": "-0.025em",
        "lineHeight": 1
      },
      "$type": "typography"
    },
    "heading-lg": {
      "$value": {
        "fontFamily": "{font.display}",
        "fontSize": "72px",
        "fontWeight": "{font-weight.medium}",
        "letterSpacing": "-0.03em",
        "lineHeight": 0.94
      },
      "$type": "typography"
    },
    "display": {
      "$value": {
        "fontFamily": "{font.display}",
        "fontSize": "96px",
        "fontWeight": "{font-weight.medium}",
        "letterSpacing": "-0.035em",
        "lineHeight": 0.88
      },
      "$type": "typography"
    },
    "price": {
      "$value": {
        "fontFamily": "{font.display}",
        "fontSize": "80px",
        "fontWeight": "{font-weight.medium}",
        "letterSpacing": "-0.03em",
        "lineHeight": 0.9
      },
      "$type": "typography"
    }
  },
  "spacing": {
    "4": { "$value": "4px", "$type": "dimension" },
    "8": { "$value": "8px", "$type": "dimension" },
    "12": { "$value": "12px", "$type": "dimension" },
    "16": { "$value": "16px", "$type": "dimension" },
    "24": { "$value": "24px", "$type": "dimension" },
    "32": { "$value": "32px", "$type": "dimension" },
    "40": { "$value": "40px", "$type": "dimension" },
    "48": { "$value": "48px", "$type": "dimension" },
    "64": { "$value": "64px", "$type": "dimension" },
    "80": { "$value": "80px", "$type": "dimension" },
    "96": { "$value": "96px", "$type": "dimension" },
    "120": { "$value": "120px", "$type": "dimension" },
    "144": { "$value": "144px", "$type": "dimension" }
  },
  "layout": {
    "page-max-width": {
      "$value": "1280px",
      "$type": "dimension"
    },
    "reading-measure": {
      "$value": "65ch",
      "$type": "dimension"
    },
    "gutter-mobile": {
      "$value": "24px",
      "$type": "dimension"
    },
    "gutter-tablet": {
      "$value": "48px",
      "$type": "dimension"
    },
    "gutter-desktop": {
      "$value": "64px",
      "$type": "dimension"
    },
    "section-mobile": {
      "$value": "80px",
      "$type": "dimension"
    },
    "section-desktop": {
      "$value": "120px",
      "$type": "dimension"
    },
    "section-wide": {
      "$value": "144px",
      "$type": "dimension"
    }
  },
  "radius": {
    "hairline": { "$value": "2px", "$type": "dimension" },
    "control": { "$value": "4px", "$type": "dimension" },
    "panel": { "$value": "8px", "$type": "dimension" },
    "round": { "$value": "9999px", "$type": "dimension" }
  },
  "border": {
    "hairline": {
      "$value": "1px",
      "$type": "dimension"
    },
    "focus": {
      "$value": "2px",
      "$type": "dimension"
    },
    "focus-offset": {
      "$value": "3px",
      "$type": "dimension"
    }
  },
  "shadow": {
    "photo": {
      "$value": {
        "color": "#2D211B24",
        "offsetX": "0px",
        "offsetY": "24px",
        "blur": "60px",
        "spread": "0px"
      },
      "$type": "shadow",
      "$description": "Single optional shadow for photographic prints"
    }
  },
  "motion": {
    "duration-fast": {
      "$value": "150ms",
      "$type": "duration"
    },
    "duration-standard": {
      "$value": "240ms",
      "$type": "duration"
    },
    "duration-reveal": {
      "$value": "600ms",
      "$type": "duration"
    },
    "ease-standard": {
      "$value": [0.22, 1, 0.36, 1],
      "$type": "cubicBezier"
    }
  },
  "component": {
    "navigation-height": {
      "$value": "72px",
      "$type": "dimension"
    },
    "control-min-height": {
      "$value": "48px",
      "$type": "dimension"
    },
    "gallery-overlap-max": {
      "$value": "24px",
      "$type": "dimension"
    }
  },
  "$extensions": {
    "com.fotohvn.design": {
      "brand": "FOTOHVN",
      "theme": "light-led",
      "reference": "https://styles.refero.design/style/db451eca-8de6-43a9-a5d5-35271befdffd",
      "adaptation": "Retain spacing, hierarchy, flat surfaces, and restrained geometry; replace the reference palette, typography, gradients, and illustration language with FOTOHVN branding."
    }
  }
}
