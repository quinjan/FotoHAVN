<Window
    x:Class="FotoHavn.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:FotoHavn.App.Controls"
    xmlns:core="using:FotoHavn.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="FotoHAVN">

    <Grid x:Name="WindowRoot" Background="#FF24262A">
        <Grid
            x:Name="FixedCanvas"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Background="{StaticResource CanvasBrush}"
            SizeChanged="OperatorCanvasSizeChanged">
            <Grid.RowDefinitions>
                <RowDefinition Height="54" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <controls:AppHeader Context="OPERATOR CONSOLE" />

            <ScrollViewer
                x:Name="EventScrollViewer"
                Grid.Row="1"
                HorizontalScrollBarVisibility="Disabled"
                HorizontalScrollMode="Disabled"
                VerticalScrollBarVisibility="Auto"
                VerticalScrollMode="Enabled"
                ZoomMode="Disabled">
                <ScrollViewer.Resources>
                    <SolidColorBrush x:Key="ScrollBarThumbFill" Color="#FFB6BBC2" />
                    <SolidColorBrush x:Key="ScrollBarThumbFillPointerOver" Color="#FF858B93" />
                    <SolidColorBrush x:Key="ScrollBarThumbFillPressed" Color="#FF5F656D" />
                    <SolidColorBrush x:Key="ScrollBarTrackFill" Color="Transparent" />
                    <SolidColorBrush x:Key="ScrollBarTrackFillPointerOver" Color="#12000000" />
                    <SolidColorBrush x:Key="ScrollBarPanningThumbBackground" Color="#FFB6BBC2" />
                </ScrollViewer.Resources>
                <StackPanel x:Name="SavedEventsContent" MaxWidth="1280" Padding="48,32,48,36" HorizontalAlignment="Stretch">
                    <Grid>
                        <controls:FocusableHeading
                            x:Name="HeadingText"
                            AutomationProperties.AutomationId="HeadingText"
                            AutomationProperties.HeadingLevel="Level1"
                            TextStyle="{StaticResource TypeHeadingPageStyle}"
                            Text="Saved Events" />
                        <Button
                            x:Name="NewEventButton"
                            HorizontalAlignment="Right"
                            Click="NewEventClicked"
                            Content="New Event"
                            Style="{StaticResource FotoHavnActionButtonPrimaryStyle}" />
                    </Grid>
                    <controls:StatusCallout
                        x:Name="SavedEventsDeletionStatus"
                        Margin="0,20,0,0"
                        Message="Deletion did not finish. Review the Event and try again."
                        Severity="Danger"
                        Title="Needs attention"
                        Visibility="Collapsed" />
                    <ItemsControl x:Name="EventTiles" Margin="0,20,0,0" HorizontalAlignment="Left" AutomationProperties.Name="Event cards">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="3" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="core:EventTilePresentation">
                                <controls:EventCard ActionRequested="EventCardActionRequested" Margin="0,0,18,18" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <Grid
                x:Name="ActiveEventLayer"
                Grid.RowSpan="2"
                Background="{StaticResource CanvasBrush}"
                SizeChanged="ActiveEventLayerSizeChanged"
                Visibility="Collapsed">
                <TextBlock
                    x:Name="SurfaceAnnouncement"
                    Width="1"
                    Height="1"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    AutomationProperties.AutomationId="FotoHavn.Announcement.Surface"
                    AutomationProperties.LiveSetting="Polite"
                    Opacity="0" />
                <Grid x:Name="StartGuestLayer">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="62" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border
                        Background="{ThemeResource ColorSurfacePanelBrush}"
                        BorderBrush="{ThemeResource ColorBorderDefaultBrush}"
                        BorderThickness="0,0,0,1">
                        <Grid Margin="32,0,19,0">
                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="10">
                                <Border Width="22" Height="22" Background="#FF202124" CornerRadius="5">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Foreground="White"
                                        FontSize="13"
                                        FontWeight="Bold"
                                        Text="F" />
                                </Border>
                                <TextBlock VerticalAlignment="Center" FontSize="15" FontWeight="Bold" Text="FotoHAVN" />
                            </StackPanel>
                            <controls:GuardedExitAction
                                x:Name="ExitEventAction"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                HoldCompleted="ExitEventHoldCompleted" />
                        </Grid>
                    </Border>
                    <StackPanel
                        x:Name="GuestStartContent"
                        Grid.Row="1"
                        Width="780"
                        Padding="0,0,0,28"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="0">
                        <TextBlock
                            x:Name="ActiveEventNameText"
                            HorizontalAlignment="Center"
                            CharacterSpacing="150"
                            FontSize="10"
                            FontWeight="Bold"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                        <TextBlock
                            x:Name="ActiveEventHeadingText"
                            Margin="0,17,0,0"
                            HorizontalAlignment="Center"
                            CharacterSpacing="-40"
                            FontSize="60"
                            FontWeight="Bold"
                            AutomationProperties.HeadingLevel="Level1"
                            TextAlignment="Center" />
                        <TextBlock
                            x:Name="ActiveEventExplanationText"
                            Margin="0,13,0,0"
                            HorizontalAlignment="Center"
                            Foreground="{StaticResource TextMutedBrush}"
                            FontSize="16"
                            TextAlignment="Center" />
                        <Button
                            x:Name="StartGuestCycleButton"
                            Width="218"
                            Height="64"
                            Margin="0,33,0,0"
                            HorizontalAlignment="Center"
                            HorizontalContentAlignment="Center"
                            AutomationProperties.Name="Touch to start"
                            AutomationProperties.AutomationId="FotoHavn.ActionButton.Primary.GuestStart"
                            Click="StartGuestCycleClicked"
                            TabIndex="0"
                            Style="{StaticResource FotoHavnActionButtonGuestProminentStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="11">
                                <FontIcon FontFamily="Segoe MDL2 Assets" FontSize="19" Glyph="&#xE768;" />
                                <TextBlock VerticalAlignment="Center" Foreground="White" Text="Touch to start" />
                            </StackPanel>
                        </Button>
                        <TextBlock
                            Width="1"
                            Height="1"
                            HorizontalAlignment="Center"
                            AutomationProperties.Name="Exit Event"
                            Opacity="0" />
                    </StackPanel>
                    <TextBlock
                        x:Name="GuestRetentionText"
                        Grid.Row="1"
                        Margin="0,0,0,66"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Foreground="#FF8B8E92"
                        FontSize="10"
                        Text="Photos stay with this Event." />
                </Grid>

                <Grid x:Name="GuestCaptureLayer" Padding="24,20,24,42" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="43" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Width="22" Height="22" Background="#FF202124" CornerRadius="5">
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" FontSize="13" FontWeight="Bold" Text="F" />
                        </Border>
                        <TextBlock VerticalAlignment="Center" FontSize="15" FontWeight="Bold" Text="FotoHAVN" />
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="12">
                        <TextBlock
                            x:Name="CaptureProgressText"
                            VerticalAlignment="Center"
                            CharacterSpacing="100"
                            FontSize="10"
                            FontWeight="Bold" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border x:Name="CaptureStep1Border" Width="32" Height="32" Background="White" BorderBrush="#FFC7CACE" BorderThickness="1" CornerRadius="16">
                                <Grid><TextBlock x:Name="CaptureStep1Number" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Text="1" /><FontIcon x:Name="CaptureStep1Check" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="13" Glyph="&#xE73E;" Visibility="Collapsed" /></Grid>
                            </Border>
                            <Border x:Name="CaptureStep2Border" Width="32" Height="32" Background="White" BorderBrush="#FFC7CACE" BorderThickness="1" CornerRadius="16">
                                <Grid><TextBlock x:Name="CaptureStep2Number" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Text="2" /><FontIcon x:Name="CaptureStep2Check" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="13" Glyph="&#xE73E;" Visibility="Collapsed" /></Grid>
                            </Border>
                            <Border x:Name="CaptureStep3Border" Width="32" Height="32" Background="White" BorderBrush="#FFC7CACE" BorderThickness="1" CornerRadius="16">
                                <Grid><TextBlock x:Name="CaptureStep3Number" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Text="3" /><FontIcon x:Name="CaptureStep3Check" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="13" Glyph="&#xE73E;" Visibility="Collapsed" /></Grid>
                            </Border>
                            <Border x:Name="CaptureStep4Border" Width="32" Height="32" Background="White" BorderBrush="#FFC7CACE" BorderThickness="1" CornerRadius="16">
                                <Grid><TextBlock x:Name="CaptureStep4Number" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Text="4" /><FontIcon x:Name="CaptureStep4Check" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="13" Glyph="&#xE73E;" Visibility="Collapsed" /></Grid>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                    <Border
                        x:Name="GuestPreviewViewport"
                        Grid.Row="1"
                        Width="922.5"
                        HorizontalAlignment="Center"
                        Background="#FF17181A"
                        BorderBrush="#FFBFC3C7"
                        BorderThickness="1"
                        CornerRadius="10">
                        <Grid>
                            <Image x:Name="GuestPreviewImage" Stretch="UniformToFill" />
                            <Border
                                Margin="0,17,17,0"
                                Padding="9,7"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Background="#E6FFFFFF"
                                CornerRadius="6">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <FontIcon FontFamily="Segoe MDL2 Assets" FontSize="13" Glyph="&#xE722;" />
                                    <TextBlock CharacterSpacing="90" FontSize="9" FontWeight="Bold" Text="LIVE · MIRRORED" />
                                </StackPanel>
                            </Border>
                            <Grid x:Name="CountdownOverlay" Background="#1A0F1011">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock HorizontalAlignment="Center" CharacterSpacing="200" Foreground="White" FontSize="13" FontWeight="Bold" Text="GET READY" />
                                    <TextBlock x:Name="CountdownText" HorizontalAlignment="Center" Foreground="White" FontSize="190" FontWeight="Bold" Text="5" />
                                </StackPanel>
                            </Grid>
                            <Grid x:Name="FlashOverlay" Background="White" Visibility="Collapsed" />
                            <Border
                                x:Name="CaptureSavedOverlay"
                                MinWidth="240"
                                MinHeight="65"
                                Margin="0,0,0,38"
                                Padding="20,10"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Bottom"
                                Background="#E6121314"
                                CornerRadius="9"
                                Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="White" Glyph="&#xE73E;" />
                                    <StackPanel><TextBlock Foreground="White" FontSize="14" FontWeight="SemiBold" Text="Capture saved" /><TextBlock Foreground="#FFD9DBDD" FontSize="10" Text="Get ready for the next one" /></StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <Grid
                    x:Name="GuestAssistanceLayer"
                    AutomationProperties.LiveSetting="Assertive"
                    Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="62" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border
                        Background="{ThemeResource ColorSurfacePanelBrush}"
                        BorderBrush="{ThemeResource ColorBorderDefaultBrush}"
                        BorderThickness="0,0,0,1">
                        <Grid Margin="32,0">
                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="10">
                                <Border Width="22" Height="22" Background="{ThemeResource ColorTextPrimaryBrush}" CornerRadius="5"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource ColorTextInverseBrush}" FontSize="13" FontWeight="Bold" Text="F" /></Border>
                                <TextBlock VerticalAlignment="Center" FontFamily="{StaticResource FotoHavnFontFamily}" FontSize="15" FontWeight="Bold" Text="FotoHAVN" />
                            </StackPanel>
                            <controls:GuardedExitAction
                                x:Name="AssistanceExitEventAction"
                                ActionAutomationId="FotoHavn.ActionButton.AssistanceExitEvent"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                HoldCompleted="ExitEventHoldCompleted" />
                        </Grid>
                    </Border>
                    <Border
                        x:Name="AssistancePanel"
                        Grid.Row="1"
                        Padding="40,30"
                        Background="{ThemeResource ColorSurfacePanelBrush}"
                        BorderBrush="{ThemeResource ColorBorderDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RadiusPanel}">
                        <StackPanel x:Name="AssistanceContent" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock x:Name="AssistanceEyebrowText" HorizontalAlignment="Center" AutomationProperties.Name="Operator Assistance label" Style="{StaticResource TypeEyebrowStyle}" Text="OPERATOR ASSISTANCE" />
                            <TextBlock x:Name="AssistanceHeadingText" Margin="0,8,0,0" HorizontalAlignment="Center" AutomationProperties.HeadingLevel="Level1" FontFamily="{StaticResource FotoHavnFontFamily}" FontSize="38" FontWeight="Bold" Text="Please call the operator" />
                            <TextBlock x:Name="AssistanceMessageText" Margin="0,10,0,0" HorizontalAlignment="Center" Style="{StaticResource TypeBodyDefaultStyle}" TextAlignment="Center" TextWrapping="Wrap" />
                            <TextBlock x:Name="AssistanceProgressText" Margin="0,10,0,0" HorizontalAlignment="Center" Foreground="{ThemeResource ColorTextMutedBrush}" Style="{StaticResource TypeBodyDefaultStyle}" TextAlignment="Center" TextWrapping="Wrap" />
                            <TextBlock
                                Width="1"
                                Height="1"
                                AutomationProperties.Name="Retry or Exit Event"
                                Opacity="0" />
                            <Button
                                x:Name="AssistanceRetryButton"
                                Width="190"
                                MinHeight="48"
                                Margin="0,20,0,0"
                                HorizontalAlignment="Center"
                                AutomationProperties.AutomationId="FotoHavn.ActionButton.AssistanceRetry"
                                AutomationProperties.Name="Retry"
                                Click="RetryGuestCycleClicked"
                                TabIndex="0"
                                Style="{StaticResource FotoHavnActionButtonPrimaryStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <ProgressRing x:Name="AssistanceRetryProgress" Width="18" Height="18" IsActive="False" Visibility="Collapsed" />
                                    <TextBlock x:Name="AssistanceRetryLabel" VerticalAlignment="Center" Style="{StaticResource TypeLabelControlStyle}" Text="Retry" />
                                </StackPanel>
                            </Button>
                            <controls:GuardedExitAction
                                x:Name="AssistanceExitOnlyAction"
                                ActionAutomationId="FotoHavn.ActionButton.AssistanceExitOnly"
                                Margin="0,20,0,0"
                                HorizontalAlignment="Center"
                                IsDestructive="True"
                                HoldCompleted="ExitEventHoldCompleted"
                                Visibility="Collapsed" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid x:Name="PhotoStripLayer" Padding="120,46" Visibility="Collapsed">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="420" /></Grid.ColumnDefinitions>
                    <StackPanel Width="520" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <TextBlock CharacterSpacing="150" FontSize="10" FontWeight="Bold" Text="ALL FOUR CAPTURES SAVED" />
                        <TextBlock Margin="0,17,0,0" AutomationProperties.HeadingLevel="Level1" CharacterSpacing="-40" FontSize="50" FontWeight="Bold" Text="Here’s your Photo Strip." />
                        <TextBlock x:Name="PhotoStripReturnText" Margin="0,14,0,0" Foreground="{StaticResource TextMutedBrush}" FontSize="15" TextWrapping="Wrap" />
                        <Grid Width="310" Height="3" Margin="0,30,0,0" HorizontalAlignment="Left" Background="#FFD8DADE">
                            <Border x:Name="ReturnProgressFill" Width="310" HorizontalAlignment="Left" Background="#FF1C1D1F" />
                        </Grid>
                    </StackPanel>
                    <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Background="White">
                        <Border.RenderTransform><RotateTransform Angle="1.5" /></Border.RenderTransform>
                        <Image x:Name="PhotoStripImage" Width="190" Height="570" Stretch="Uniform" />
                    </Border>
                </Grid>

                <controls:ModalDialogSurface
                    x:Name="ExitEventConfirmationLayer"
                    AutomationProperties.Name="Exit Event confirmation"
                    Background="#8A17181A"
                    KeyDown="ExitEventConfirmationKeyDown"
                    Visibility="Collapsed">
                    <controls:ConfirmationDialogFrame x:Name="ExitConfirmationFrame">
                        <controls:ConfirmationDialogFrame.DialogContent>
                        <StackPanel Spacing="{StaticResource DialogContentSpacing}">
                            <controls:DialogSemanticIcon HorizontalAlignment="Center" Glyph="&#xE7E8;" Intent="Destructive" />
                            <controls:FocusableHeading
                                x:Name="ExitEventTitleText"
                                HorizontalAlignment="Center"
                                AutomationProperties.AutomationId="ExitEventTitleText"
                                AutomationProperties.HeadingLevel="Level1"
                                FontSize="32"
                                FontWeight="Bold"
                                Text="Exit this Event?"
                                TextAlignment="Center" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                AutomationProperties.Name="Consequence when present"
                                Foreground="{StaticResource TextMutedBrush}"
                                Text="The Camera will be released and FotoHAVN will return to Saved Events."
                                TextAlignment="Center"
                                TextWrapping="Wrap" />
                            <StackPanel AutomationProperties.Name="Dialog actions" HorizontalAlignment="Stretch" Orientation="Horizontal" Spacing="10">
                                <Button x:Name="KeepEventActiveButton" AutomationProperties.AutomationId="FotoHavn.Confirmation.SafeAction" Click="CancelExitEventClicked" Content="Keep Event Active" Style="{StaticResource FotoHavnActionButtonSecondaryStyle}" />
                                <Button
                                    x:Name="ConfirmExitEventButton"
                                    AutomationProperties.AutomationId="FotoHavn.Confirmation.ConfirmingAction"
                                    Click="ConfirmExitEventClicked"
                                    Content="Exit Event"
                                    Style="{StaticResource FotoHavnActionButtonDestructiveStyle}" />
                            </StackPanel>
                        </StackPanel>
                        </controls:ConfirmationDialogFrame.DialogContent>
                    </controls:ConfirmationDialogFrame>
                </controls:ModalDialogSurface>
            </Grid>

            <Grid
                x:Name="EventDeletionLayer"
                Grid.RowSpan="2"
                Background="#8A17181A"
                Visibility="Collapsed">
                <controls:ConfirmationDialogFrame x:Name="DeletionConfirmationFrame">
                    <controls:ConfirmationDialogFrame.DialogContent>
                    <StackPanel Spacing="{StaticResource DialogContentSpacing}">
                        <controls:DialogSemanticIcon x:Name="EventDeletionSemanticIcon" HorizontalAlignment="Center" Glyph="&#xE74D;" Intent="Destructive" />
                        <controls:FocusableHeading
                            x:Name="EventDeletionTitleText"
                            HorizontalAlignment="Center"
                            AutomationProperties.AutomationId="EventDeletionTitleText"
                            AutomationProperties.HeadingLevel="Level1"
                            FontSize="32"
                            FontWeight="Bold"
                            TextAlignment="Center" />
                        <TextBlock
                            x:Name="EventDeletionMessageText"
                            HorizontalAlignment="Center"
                            AutomationProperties.Name="Consequence when present"
                            Foreground="{StaticResource TextMutedBrush}"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                        <controls:DialogEventIdentity x:Name="EventDeletionIdentity" />
                        <controls:StatusCallout
                            x:Name="EventDeletionFailureStatus"
                            Message="Deletion did not finish. Review the Event and try again."
                            Severity="Danger"
                            Title="Needs attention"
                            Visibility="Collapsed" />
                        <StackPanel
                            x:Name="EventDeletionActions"
                            AutomationProperties.Name="Dialog actions"
                            HorizontalAlignment="Stretch"
                            Orientation="Horizontal"
                            Spacing="10">
                            <Button
                                x:Name="CancelEventDeletionButton"
                                AutomationProperties.AutomationId="FotoHavn.Confirmation.SafeAction"
                                Click="CancelEventDeletionClicked"
                                Content="Cancel"
                                Style="{StaticResource FotoHavnActionButtonSecondaryStyle}" />
                            <Button
                                x:Name="ConfirmEventDeletionButton"
                                AutomationProperties.AutomationId="FotoHavn.Confirmation.ConfirmingAction"
                                Click="ConfirmEventDeletionClicked"
                                Content="Delete Event"
                                Style="{StaticResource FotoHavnActionButtonDestructiveStyle}" />
                        </StackPanel>
                    </StackPanel>
                    </controls:ConfirmationDialogFrame.DialogContent>
                </controls:ConfirmationDialogFrame>
            </Grid>

            <Grid
                x:Name="StartEventConfirmationLayer"
                Grid.RowSpan="2"
                Background="#8A17181A"
                Visibility="Collapsed">
                <controls:ConfirmationDialogFrame x:Name="StartConfirmationFrame">
                    <controls:ConfirmationDialogFrame.DialogContent>
                    <StackPanel Spacing="{StaticResource DialogContentSpacing}">
                        <controls:DialogSemanticIcon HorizontalAlignment="Center" Glyph="&#xF5B0;" />
                        <controls:FocusableHeading
                            x:Name="StartEventConfirmationText"
                            HorizontalAlignment="Center"
                            AutomationProperties.AutomationId="StartEventConfirmationText"
                            AutomationProperties.HeadingLevel="Level1"
                            FontSize="32"
                            FontWeight="Bold"
                            TextAlignment="Center" />
                        <TextBlock
                            AutomationProperties.Name="Consequence when present"
                            Foreground="{StaticResource TextMutedBrush}"
                            Text="FotoHAVN will confirm the Camera bound to this Event and storage before starting."
                            TextWrapping="Wrap"
                            Visibility="Collapsed" />
                        <controls:DialogEventIdentity x:Name="StartEventIdentity" />
                        <controls:StatusCallout
                            x:Name="StartEventFailureStatus"
                            Message="The action did not finish. Review the Event and try again."
                            Severity="Danger"
                            Title="Needs attention"
                            Visibility="Collapsed" />
                        <StackPanel AutomationProperties.Name="Dialog actions" HorizontalAlignment="Stretch" Orientation="Horizontal" Spacing="10">
                            <Button x:Name="CancelStartEventButton" AutomationProperties.AutomationId="FotoHavn.Confirmation.SafeAction" Click="CancelStartEventClicked" Content="Cancel" Style="{StaticResource FotoHavnActionButtonSecondaryStyle}" />
                            <Button
                                x:Name="ConfirmStartEventButton"
                                AutomationProperties.AutomationId="FotoHavn.Confirmation.ConfirmingAction"
                                Click="ConfirmStartEventClicked"
                                Content="Start Event"
                                Style="{StaticResource FotoHavnActionButtonPrimaryStyle}" />
                        </StackPanel>
                    </StackPanel>
                    </controls:ConfirmationDialogFrame.DialogContent>
                </controls:ConfirmationDialogFrame>
            </Grid>

            <Grid
                x:Name="SetupLayer"
                Grid.RowSpan="2"
                Background="#8A17181A"
                Visibility="Collapsed">
                <Border
                    x:Name="SetupDialog"
                    MaxWidth="1100"
                    MaxHeight="640"
                    Margin="24"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Background="{StaticResource SurfaceBrush}"
                    CornerRadius="14"
                    KeyDown="SetupLayerKeyDown">
                    <Grid x:Name="SetupContentGrid" Padding="34">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition x:Name="SetupFooterRow" Height="80" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.ColumnSpan="3" Spacing="4">
                            <TextBlock
                                CharacterSpacing="180"
                                FontSize="9"
                                FontWeight="Bold"
                                Text="EVENT SETUP" />
                            <controls:FocusableHeading
                                x:Name="SetupTitleText"
                                AutomationProperties.AutomationId="SetupTitleText"
                                AutomationProperties.HeadingLevel="Level1"
                                Margin="0,6,0,0"
                                FontSize="32"
                                FontWeight="Bold"
                                Text="New Event" />
                            <TextBlock
                                x:Name="EventSetupIdentityText"
                                AutomationProperties.Name="Event identity"
                                Foreground="{StaticResource TextMutedBrush}"
                                Style="{StaticResource TypeCaptionStyle}" />
                            <TextBlock
                                x:Name="SetupIntroductionText"
                                Foreground="{StaticResource TextMutedBrush}"
                                Text="Name the Event and choose its Camera and Printer." />
                        </StackPanel>

                        <ScrollViewer
                            x:Name="SetupScrollViewer"
                            Grid.Row="1"
                            Padding="{StaticResource SetupScrollContentPadding}"
                            HorizontalScrollBarVisibility="Disabled"
                            HorizontalScrollMode="Disabled"
                            VerticalScrollBarVisibility="Auto"
                            VerticalScrollMode="Enabled"
                            ZoomMode="Disabled">
                            <Grid x:Name="SetupBodyGrid" Margin="0,28,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="SetupFieldsColumn" Width="*" />
                                    <ColumnDefinition x:Name="SetupGapColumn" Width="34" />
                                    <ColumnDefinition x:Name="SetupPreviewColumn" Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <controls:SetupFieldGroup
                                    x:Name="EventIdentityFieldGroup"
                                    Grid.Row="0"
                                    Margin="0,0,0,18"
                                    AutomationProperties.Name="Event identity"
                                    Label="Event ID"
                                    Visibility="Collapsed">
                                    <controls:SetupFieldGroup.FieldContent>
                                        <TextBox
                                            x:Name="EventIdentityValueText"
                                            HorizontalAlignment="Stretch"
                                            AutomationProperties.Name="Full Event ID"
                                            IsReadOnly="True"
                                            Style="{StaticResource FotoHavnTextFieldStyle}" />
                                    </controls:SetupFieldGroup.FieldContent>
                                </controls:SetupFieldGroup>

                                <controls:SetupFieldGroup x:Name="EventNameFieldGroup" Grid.Row="1" Margin="0,0,0,18" AutomationProperties.Name="Event name" Label="Event name">
                                    <controls:SetupFieldGroup.FieldContent>
                                        <TextBox
                                            x:Name="EventNameTextBox"
                                            HorizontalAlignment="Stretch"
                                            AutomationProperties.Name="Event name"
                                            PlaceholderText="Enter Event name"
                                            Style="{StaticResource FotoHavnTextFieldStyle}"
                                            TextChanged="EventNameTextChanged" />
                                    </controls:SetupFieldGroup.FieldContent>
                                    <controls:SetupFieldGroup.HelperContent>
                                        <TextBlock
                                            x:Name="EventNameHelperText"
                                            Foreground="{StaticResource TextMutedBrush}"
                                            Style="{StaticResource TypeCaptionStyle}"
                                            Text="Names do not need to be unique."
                                            Visibility="Collapsed" />
                                    </controls:SetupFieldGroup.HelperContent>
                                </controls:SetupFieldGroup>

                                <controls:SetupFieldGroup x:Name="CameraFieldGroup" Grid.Row="2" Margin="0,0,0,18" AutomationProperties.Name="Camera and status" Label="Camera">
                                    <controls:SetupFieldGroup.FieldContent>
                                        <ComboBox
                                            x:Name="CameraComboBox"
                                            HorizontalAlignment="Stretch"
                                            AutomationProperties.Name="Camera"
                                            DisplayMemberPath="DisplayName"
                                            MaxDropDownHeight="230"
                                            PlaceholderText="Select Camera"
                                            SelectionChanged="CameraSelectionChanged"
                                            Style="{StaticResource FotoHavnSelectFieldStyle}" />
                                    </controls:SetupFieldGroup.FieldContent>
                                    <controls:SetupFieldGroup.HelperContent>
                                        <TextBlock
                                            x:Name="CameraHelperText"
                                            Foreground="{StaticResource TextMutedBrush}"
                                            Style="{StaticResource TypeCaptionStyle}"
                                            Text="Only available Cameras are shown."
                                            Visibility="Collapsed" />
                                    </controls:SetupFieldGroup.HelperContent>
                                </controls:SetupFieldGroup>

                                <StackPanel
                                    x:Name="SetupPreviewPanel"
                                    Grid.Row="0"
                                    Grid.RowSpan="7"
                                    Grid.Column="2"
                                    AutomationProperties.Name="Camera preview">
                                    <controls:CameraViewport
                                        x:Name="SetupCameraViewport"
                                        HorizontalAlignment="Stretch"
                                        IsMirrored="True"
                                        Mode="SetupPreview"
                                        SizeChanged="SetupCameraViewportSizeChanged"
                                        Status="Unavailable" />
                                </StackPanel>

                                <controls:SetupFieldGroup x:Name="PrinterFieldGroup" Grid.Row="3" Margin="0,0,0,18" AutomationProperties.Name="Printer" Label="Printer (optional)">
                                    <controls:SetupFieldGroup.FieldContent>
                                        <ComboBox
                                            x:Name="PrinterComboBox"
                                            HorizontalAlignment="Stretch"
                                            AutomationProperties.Name="Printer"
                                            SelectedIndex="0"
                                            SelectionChanged="PrinterSelectionChanged"
                                            Style="{StaticResource FotoHavnSelectFieldStyle}">
                                            <ComboBoxItem Content="Not printing" />
                                        </ComboBox>
                                    </controls:SetupFieldGroup.FieldContent>
                                </controls:SetupFieldGroup>

                                <controls:SetupFieldGroup x:Name="StorageFieldGroup" Grid.Row="4" Margin="0,0,0,18" AutomationProperties.Name="Storage" Label="Storage">
                                    <controls:SetupFieldGroup.FieldContent>
                                        <TextBlock Style="{StaticResource FotoHavnReadOnlyValueStyle}" Text="C:\Program Files\FotoHAVN\Events" />
                                    </controls:SetupFieldGroup.FieldContent>
                                    <controls:SetupFieldGroup.HelperContent>
                                        <TextBlock
                                            Foreground="{StaticResource TextMutedBrush}"
                                            Style="{StaticResource TypeCaptionStyle}"
                                            Text="Requires at least 1 GB free." />
                                    </controls:SetupFieldGroup.HelperContent>
                                </controls:SetupFieldGroup>

                                <Border
                                    x:Name="SetupFailureBorder"
                                    Grid.Row="5"
                                    Padding="12"
                                    Background="#FFFFF4F2"
                                    BorderBrush="#FFD58B82"
                                    BorderThickness="1"
                                    CornerRadius="7"
                                    Visibility="Collapsed">
                                    <StackPanel Spacing="10">
                                        <TextBlock
                                            x:Name="SetupFailureText"
                                            Foreground="#FF74342D"
                                            TextWrapping="Wrap" />
                                        <Button
                                            x:Name="RetryStorageButton"
                                            HorizontalAlignment="Left"
                                            Click="RetryStorageClicked"
                                            Content="Check storage again"
                                            Visibility="Collapsed" />
                                    </StackPanel>
                                </Border>

                            </Grid>
                        </ScrollViewer>

                        <Grid x:Name="SetupFooter" Grid.Row="2" Margin="0,16,0,0" AutomationProperties.Name="Footer actions">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Button x:Name="CancelSetupButton" AutomationProperties.AutomationId="FotoHavn.EventSetup.SafeAction" Content="Cancel" Click="CancelSetupClicked" Style="{StaticResource FotoHavnActionButtonSecondaryStyle}" />
                            <StackPanel x:Name="SetupCommitActions" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="10">
                                <Button x:Name="SaveCloseButton" AutomationProperties.AutomationId="FotoHavn.EventSetup.SaveClose" Content="Save &amp; Close" Click="SaveCloseClicked" IsEnabled="False" Style="{StaticResource FotoHavnActionButtonSecondaryStyle}" />
                                <Button x:Name="SaveStartButton" AutomationProperties.AutomationId="FotoHavn.EventSetup.PrimarySaveStart" Content="Save &amp; Start Event" Click="SaveStartClicked" IsEnabled="False" Style="{StaticResource FotoHavnActionButtonPrimaryStyle}" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <Grid
                    x:Name="DiscardDraftLayer"
                    Background="#8A17181A"
                    Visibility="Collapsed">
                    <controls:ConfirmationDialogFrame x:Name="DiscardConfirmationFrame">
                        <controls:ConfirmationDialogFrame.DialogContent>
                        <StackPanel Spacing="{StaticResource DialogContentSpacing}">
                            <controls:DialogSemanticIcon HorizontalAlignment="Center" Glyph="&#xE711;" Intent="Destructive" />
                            <controls:FocusableHeading x:Name="DiscardTitleText" HorizontalAlignment="Center" AutomationProperties.AutomationId="DiscardTitleText" FontSize="32" FontWeight="Bold" Text="Discard this draft?" TextAlignment="Center" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                AutomationProperties.Name="Consequence when present"
                                Foreground="{StaticResource TextMutedBrush}"
                                Text="Your unsaved Event changes will be lost."
                                TextAlignment="Center"
                                TextWrapping="Wrap" />
                            <StackPanel AutomationProperties.Name="Dialog actions" HorizontalAlignment="Stretch" Orientation="Horizontal" Spacing="10">
                                <Button AutomationProperties.AutomationId="FotoHavn.Confirmation.SafeAction" Content="Keep Editing" Click="KeepEditingClicked" Style="{StaticResource FotoHavnActionButtonSecondaryStyle}" />
                                <Button x:Name="DiscardActionButton" AutomationProperties.AutomationId="FotoHavn.Confirmation.ConfirmingAction" Content="Discard Draft" Click="DiscardDraftClicked" Style="{StaticResource FotoHavnActionButtonDestructiveStyle}" />
                            </StackPanel>
                        </StackPanel>
                        </controls:ConfirmationDialogFrame.DialogContent>
                    </controls:ConfirmationDialogFrame>
                </Grid>

                <Grid
                    x:Name="SaveChangesLayer"
                    Background="#8A17181A"
                    Visibility="Collapsed">
                    <controls:ConfirmationDialogFrame x:Name="SaveConfirmationFrame">
                        <controls:ConfirmationDialogFrame.DialogContent>
                        <StackPanel Spacing="{StaticResource DialogContentSpacing}">
                            <controls:DialogSemanticIcon HorizontalAlignment="Center" Glyph="&#xE74E;" />
                            <controls:FocusableHeading x:Name="SaveChangesTitleText" HorizontalAlignment="Center" AutomationProperties.AutomationId="SaveChangesTitleText" FontSize="32" FontWeight="Bold" Text="Save changes?" TextAlignment="Center" />
                            <TextBlock
                                AutomationProperties.Name="Consequence when present"
                                Foreground="{StaticResource TextMutedBrush}"
                                Text="The new Event name and Camera Binding affect only future Guest Cycles. Completed Guest Cycles and their artifacts will not change."
                                TextWrapping="Wrap"
                                Visibility="Collapsed" />
                            <controls:DialogEventIdentity x:Name="SaveEventIdentity" />
                            <StackPanel AutomationProperties.Name="Dialog actions" HorizontalAlignment="Stretch" Orientation="Horizontal" Spacing="10">
                                <Button x:Name="CancelSaveButton" AutomationProperties.AutomationId="FotoHavn.Confirmation.SafeAction" Content="Keep Editing" Click="CancelSaveClicked" Style="{StaticResource FotoHavnActionButtonSecondaryStyle}" />
                                <Button x:Name="ConfirmSaveButton" AutomationProperties.AutomationId="FotoHavn.Confirmation.ConfirmingAction" Content="Save Changes" Click="ConfirmSaveClicked" Style="{StaticResource FotoHavnActionButtonPrimaryStyle}" />
                            </StackPanel>
                        </StackPanel>
                        </controls:ConfirmationDialogFrame.DialogContent>
                    </controls:ConfirmationDialogFrame>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
