<Window
    x:Class="FotoHavn.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:FotoHavn.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="FotoHAVN">

    <Grid x:Name="WindowRoot" Background="#FF24262A">
        <Grid
            x:Name="FixedCanvas"
            Width="1280"
            Height="720"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="{StaticResource CanvasBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="54" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource HairlineBrush}"
                BorderThickness="0,0,0,1">
                <Grid Margin="17,0">
                    <StackPanel
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="10">
                        <Border
                            Width="20"
                            Height="20"
                            Background="#FF202124"
                            CornerRadius="5">
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground="White"
                                FontSize="12"
                                FontWeight="Bold"
                                Text="F" />
                        </Border>
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="15"
                            FontWeight="SemiBold"
                            Text="FotoHAVN" />
                    </StackPanel>
                    <TextBlock
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        CharacterSpacing="180"
                        FontSize="9"
                        FontWeight="Bold"
                        Text="OPERATOR CONSOLE" />
                </Grid>
            </Border>

            <ScrollViewer
                x:Name="EventScrollViewer"
                Grid.Row="1"
                HorizontalScrollBarVisibility="Disabled"
                HorizontalScrollMode="Disabled"
                VerticalScrollBarVisibility="Auto"
                VerticalScrollMode="Enabled"
                ZoomMode="Disabled">
                <ScrollViewer.Resources>
                    <SolidColorBrush x:Key="ScrollBarThumbFill" Color="#FFB6BBC2" />
                    <SolidColorBrush x:Key="ScrollBarThumbFillPointerOver" Color="#FF858B93" />
                    <SolidColorBrush x:Key="ScrollBarThumbFillPressed" Color="#FF5F656D" />
                    <SolidColorBrush x:Key="ScrollBarTrackFill" Color="Transparent" />
                    <SolidColorBrush x:Key="ScrollBarTrackFillPointerOver" Color="#12000000" />
                    <SolidColorBrush x:Key="ScrollBarPanningThumbBackground" Color="#FFB6BBC2" />
                </ScrollViewer.Resources>
                <StackPanel
                    Width="1012"
                    Padding="0,48,0,56"
                    HorizontalAlignment="Center">
                    <TextBlock
                        CharacterSpacing="180"
                        FontSize="9"
                        FontWeight="Bold"
                        Text="SAVED EVENTS" />
                    <TextBlock
                        x:Name="HeadingText"
                        Margin="0,10,0,0"
                        FontSize="32"
                        FontWeight="Bold"
                        Text="Choose an Event" />
                    <TextBlock
                        Margin="0,4,0,0"
                        Foreground="{StaticResource TextMutedBrush}"
                        FontSize="15"
                        Text="Open one to adjust its setup, or start a Guest Cycle." />

                    <ItemsControl
                        x:Name="EventTiles"
                        Width="1026"
                        Margin="0,36,0,0"
                        HorizontalAlignment="Left">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="3" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="core:EventTilePresentation">
                            <Grid
                                Width="328"
                                Height="188"
                                Margin="0,0,14,14">
                                <Button
                                    AutomationProperties.Name="{x:Bind Label}"
                                    Click="EventTileClicked"
                                    Style="{StaticResource EventTileButtonStyle}"
                                    Visibility="{x:Bind ShowsCreate}">
                                    <Button.Resources>
                                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#FFF1F2F4" />
                                        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#FFE8EAED" />
                                        <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#FFC8CCD2" />
                                        <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#FFBFC4CB" />
                                    </Button.Resources>
                                    <StackPanel
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Spacing="10">
                                        <Border
                                            Width="36"
                                            Height="36"
                                            HorizontalAlignment="Center"
                                            Background="#FF1C1D1F"
                                            CornerRadius="18">
                                            <FontIcon
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontFamily="Segoe MDL2 Assets"
                                                FontSize="16"
                                                Foreground="White"
                                                Glyph="&#xE710;" />
                                        </Border>
                                        <StackPanel HorizontalAlignment="Center" Spacing="6">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                FontSize="15"
                                                FontWeight="Bold"
                                                Text="{x:Bind Label}" />
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                Foreground="{StaticResource TextMutedBrush}"
                                                FontSize="11"
                                                Text="{x:Bind SupportingText}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Button>

                                <Border
                                    x:Name="SavedEventCard"
                                    Padding="24"
                                    Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource HairlineBrush}"
                                    BorderThickness="1"
                                    CornerRadius="9"
                                    PointerEntered="SavedEventCardPointerEntered"
                                    PointerExited="SavedEventCardPointerExited"
                                    Visibility="{x:Bind ShowsStart}">
                                    <Grid>
                                        <StackPanel
                                            x:Name="SavedEventMetadata"
                                            Margin="0,0,46,0"
                                            VerticalAlignment="Bottom"
                                            Spacing="5">
                                            <TextBlock
                                                FontSize="15"
                                                FontWeight="Bold"
                                                Text="{x:Bind Label}"
                                                TextTrimming="CharacterEllipsis"
                                                ToolTipService.ToolTip="{x:Bind Label}" />
                                            <TextBlock
                                                Foreground="{StaticResource TextMutedBrush}"
                                                FontSize="11"
                                                Text="{x:Bind SupportingText}"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <Button
                                            x:Name="StartEventButton"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            AutomationProperties.Name="Start Event"
                                            Click="StartSavedEventClicked"
                                            GotFocus="StartEventButtonGotFocus"
                                            LostFocus="StartEventButtonLostFocus"
                                            Opacity="0"
                                            Style="{StaticResource EventStartButtonStyle}"
                                            Visibility="{x:Bind ShowsStart}">
                                            <Button.Resources>
                                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="Transparent" />
                                                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="Transparent" />
                                                <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
                                                <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
                                            </Button.Resources>
                                            <StackPanel HorizontalAlignment="Center" Spacing="7">
                                                <FontIcon
                                                    HorizontalAlignment="Center"
                                                    FontFamily="Segoe MDL2 Assets"
                                                    FontSize="26"
                                                    Glyph="&#xF5B0;" />
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    FontSize="12"
                                                    Text="Start Event" />
                                            </StackPanel>
                                        </Button>

                                        <Button
                                            Margin="0,-12,-12,0"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            AutomationProperties.Name="Delete Event"
                                            Click="DeleteSavedEventClicked"
                                            Foreground="{StaticResource DangerBrush}"
                                            Style="{StaticResource EventActionButtonStyle}"
                                            Visibility="{x:Bind ShowsDelete}">
                                            <FontIcon
                                                FontFamily="Segoe MDL2 Assets"
                                                FontSize="12"
                                                Glyph="&#xE74D;" />
                                        </Button>

                                        <Button
                                            Margin="0,0,-12,-12"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Bottom"
                                            AutomationProperties.Name="Edit Event"
                                            Click="EditSavedEventClicked"
                                            Style="{StaticResource EventActionButtonStyle}"
                                            Visibility="{x:Bind ShowsEdit}">
                                            <FontIcon
                                                FontFamily="Segoe MDL2 Assets"
                                                FontSize="12"
                                                Glyph="&#xE713;" />
                                        </Button>
                                    </Grid>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <Grid
                x:Name="SetupLayer"
                Grid.RowSpan="2"
                Background="#8A17181A"
                Visibility="Collapsed">
                <Border
                    x:Name="SetupDialog"
                    Width="1100"
                    Height="640"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{StaticResource SurfaceBrush}"
                    CornerRadius="14"
                    KeyDown="SetupLayerKeyDown">
                    <Grid Padding="34">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="410" />
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.ColumnSpan="3" Spacing="4">
                            <TextBlock x:Name="SetupTitleText" FontSize="28" FontWeight="SemiBold" Text="New Event" />
                            <TextBlock Foreground="{StaticResource TextMutedBrush}" Text="Choose the exact Camera for this Event." />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Margin="0,28,0,0" Spacing="18">
                            <StackPanel Spacing="7">
                                <TextBlock FontWeight="SemiBold" Text="Event name" />
                                <TextBox
                                    x:Name="EventNameTextBox"
                                    AutomationProperties.Name="Event name"
                                    PlaceholderText="Enter Event name"
                                    TextChanged="EventNameTextChanged" />
                                <TextBlock
                                    x:Name="NameDirtyText"
                                    Foreground="{StaticResource FocusVisualPrimaryBrush}"
                                    FontSize="11"
                                    Text="Changed from the saved Event"
                                    Visibility="Collapsed" />
                            </StackPanel>

                            <StackPanel Spacing="7">
                                <TextBlock FontWeight="SemiBold" Text="Camera" />
                                <Button
                                    x:Name="CameraMenuButton"
                                    HorizontalContentAlignment="Stretch"
                                    AutomationProperties.Name="Camera"
                                    Click="CameraMenuButtonClicked">
                                    <Grid Width="350">
                                        <TextBlock x:Name="CameraMenuButtonText" HorizontalAlignment="Left" Text="Select Camera" />
                                        <TextBlock HorizontalAlignment="Right" Text="⌄" />
                                    </Grid>
                                    <Button.Flyout>
                                        <Flyout
                                            x:Name="CameraFlyout"
                                            Closed="CameraFlyoutClosed"
                                            Placement="BottomEdgeAlignedLeft">
                                            <ListView
                                                x:Name="CameraList"
                                                Width="350"
                                                MaxHeight="230"
                                                IsItemClickEnabled="True"
                                                ItemClick="CameraItemClicked">
                                                <ListView.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Padding="4" Spacing="2">
                                                            <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" />
                                                            <TextBlock FontSize="12" Foreground="{StaticResource TextMutedBrush}" Text="{Binding SecondaryLabel}" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ListView.ItemTemplate>
                                            </ListView>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                                <TextBlock x:Name="CameraStatusText" Foreground="{StaticResource TextMutedBrush}" Text="Select a Camera" />
                                <TextBlock
                                    x:Name="CameraDirtyText"
                                    Foreground="{StaticResource FocusVisualPrimaryBrush}"
                                    FontSize="11"
                                    Text="Changed from the saved Event"
                                    Visibility="Collapsed" />
                            </StackPanel>

                            <StackPanel Spacing="7">
                                <TextBlock FontWeight="SemiBold" Text="Printer" />
                                <ComboBox
                                    x:Name="PrinterComboBox"
                                    Width="370"
                                    HorizontalAlignment="Left"
                                    AutomationProperties.Name="Printer"
                                    PlaceholderText="Choose Printer"
                                    SelectionChanged="PrinterSelectionChanged">
                                    <ComboBoxItem Content="No Printer" />
                                </ComboBox>
                                <TextBlock
                                    x:Name="StorageStatusText"
                                    Foreground="{StaticResource DangerBrush}"
                                    FontSize="11"
                                    Text="Event storage is not writable. Nothing was saved or started."
                                    TextWrapping="Wrap"
                                    Visibility="Collapsed" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,28,0,0" Spacing="8">
                            <TextBlock FontWeight="SemiBold" Text="Live preview" />
                            <Border
                                x:Name="PreviewViewport"
                                Height="392"
                                HorizontalAlignment="Left"
                                Background="#FF17181A"
                                CornerRadius="8">
                                <Grid>
                                    <Grid x:Name="PreviewSurface">
                                        <Image x:Name="PreviewImage" Stretch="UniformToFill" />
                                    </Grid>
                                    <!-- The full preview viewport is the deterministic 3:2 Capture crop. -->
                                    <Border BorderBrush="White" BorderThickness="2" CornerRadius="5" Opacity="0.82" />
                                    <TextBlock
                                        Margin="12"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Bottom"
                                        Foreground="White"
                                        FontSize="12"
                                        Text="3:2 Capture area" />
                                </Grid>
                            </Border>
                        </StackPanel>

                        <Grid Grid.Row="2" Grid.ColumnSpan="3" Margin="0,24,0,0">
                            <Button Content="Cancel" Click="CancelSetupClicked" />
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="10">
                                <Button x:Name="SaveCloseButton" Content="Save &amp; Close" Click="SaveCloseClicked" IsEnabled="False" />
                                <Button x:Name="SaveStartButton" Content="Save &amp; Start Event" Click="SaveStartClicked" IsEnabled="False" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <Grid
                    x:Name="DiscardDraftLayer"
                    Background="#B817181A"
                    Visibility="Collapsed">
                    <Border
                        Width="430"
                        Padding="28"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="{StaticResource SurfaceBrush}"
                        CornerRadius="12">
                        <StackPanel Spacing="18">
                            <TextBlock x:Name="DiscardTitleText" FontSize="24" FontWeight="SemiBold" Text="Discard this draft?" />
                            <TextBlock
                                Foreground="{StaticResource TextMutedBrush}"
                                Text="Your unsaved Event changes will be lost."
                                TextWrapping="Wrap" />
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="10">
                                <Button Content="Keep Editing" Click="KeepEditingClicked" />
                                <Button x:Name="DiscardActionButton" Content="Discard Draft" Click="DiscardDraftClicked" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid
                    x:Name="SaveChangesLayer"
                    Background="#B817181A"
                    Visibility="Collapsed">
                    <Border
                        Width="500"
                        Padding="28"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="{StaticResource SurfaceBrush}"
                        CornerRadius="12">
                        <StackPanel Spacing="18">
                            <TextBlock FontSize="24" FontWeight="SemiBold" Text="Save Event changes?" />
                            <TextBlock
                                Foreground="{StaticResource TextMutedBrush}"
                                Text="The new Event name and Camera Binding affect only future Guest Cycles. Completed Guest Cycles and their artifacts will not change."
                                TextWrapping="Wrap" />
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="10">
                                <Button Content="Keep Editing" Click="CancelSaveClicked" />
                                <Button x:Name="ConfirmSaveButton" Content="Save Changes" Click="ConfirmSaveClicked" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
