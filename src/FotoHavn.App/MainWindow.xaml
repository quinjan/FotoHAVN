<Window
    x:Class="FotoHavn.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="FotoHAVN">

    <Grid x:Name="WindowRoot" Background="#FF24262A">
        <Grid
            x:Name="FixedCanvas"
            Width="1280"
            Height="720"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="{StaticResource CanvasBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="112" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Margin="56,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Spacing="3">
                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="FotoHAVN" />
                    <TextBlock Foreground="{StaticResource TextMutedBrush}" Text="Operator console" />
                </StackPanel>
                <Border
                    Grid.Column="1"
                    Padding="12,6"
                    VerticalAlignment="Center"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource HairlineBrush}"
                    BorderThickness="1"
                    CornerRadius="16">
                    <TextBlock FontSize="12" FontWeight="SemiBold" Text="SAVED EVENTS" />
                </Border>
            </Grid>

            <Grid Grid.Row="1" Margin="56,42,56,56">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="36" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Spacing="7">
                    <TextBlock
                        x:Name="HeadingText"
                        FontSize="36"
                        FontWeight="SemiBold"
                        Text="Saved Events" />
                    <TextBlock
                        Foreground="{StaticResource TextMutedBrush}"
                        FontSize="15"
                        Text="Choose an Event to run or create a new one." />
                </StackPanel>

                <ItemsControl x:Name="EventTiles" Grid.Row="2">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="3" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button
                                Width="344"
                                Height="212"
                                Margin="0,0,20,20"
                                AutomationProperties.Name="{Binding Label}"
                                Click="EventTileClicked"
                                Style="{StaticResource EventTileButtonStyle}">
                                <Grid Margin="26">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Border
                                        Width="48"
                                        Height="48"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        Background="#FF17181A"
                                        CornerRadius="24">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Foreground="White"
                                            FontSize="22"
                                            Text="{Binding Glyph}" />
                                    </Border>
                                    <StackPanel Grid.Row="1" Spacing="5">
                                        <TextBlock FontSize="21" FontWeight="SemiBold" Text="{Binding Label}" />
                                        <TextBlock
                                            Foreground="{StaticResource TextMutedBrush}"
                                            FontSize="13"
                                            Text="{Binding SupportingText}" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>

            <Grid
                x:Name="SetupLayer"
                Grid.RowSpan="2"
                Background="#8A17181A"
                Visibility="Collapsed">
                <Border
                    Width="1100"
                    Height="640"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{StaticResource SurfaceBrush}"
                    CornerRadius="14"
                    KeyDown="SetupLayerKeyDown">
                    <Grid Padding="34">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="410" />
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.ColumnSpan="3" Spacing="4">
                            <TextBlock FontSize="28" FontWeight="SemiBold" Text="New Event" />
                            <TextBlock Foreground="{StaticResource TextMutedBrush}" Text="Choose the exact Camera for this Event." />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Margin="0,28,0,0" Spacing="18">
                            <StackPanel Spacing="7">
                                <TextBlock FontWeight="SemiBold" Text="Event name" />
                                <TextBox
                                    x:Name="EventNameTextBox"
                                    AutomationProperties.Name="Event name"
                                    PlaceholderText="Enter Event name"
                                    TextChanged="EventNameTextChanged" />
                            </StackPanel>

                            <StackPanel Spacing="7">
                                <TextBlock FontWeight="SemiBold" Text="Camera" />
                                <Button
                                    x:Name="CameraMenuButton"
                                    HorizontalContentAlignment="Stretch"
                                    AutomationProperties.Name="Camera"
                                    Click="CameraMenuButtonClicked">
                                    <Grid Width="350">
                                        <TextBlock x:Name="CameraMenuButtonText" HorizontalAlignment="Left" Text="Select Camera" />
                                        <TextBlock HorizontalAlignment="Right" Text="⌄" />
                                    </Grid>
                                    <Button.Flyout>
                                        <Flyout
                                            x:Name="CameraFlyout"
                                            Closed="CameraFlyoutClosed"
                                            Placement="BottomEdgeAlignedLeft">
                                            <ListView
                                                x:Name="CameraList"
                                                Width="350"
                                                MaxHeight="230"
                                                IsItemClickEnabled="True"
                                                ItemClick="CameraItemClicked">
                                                <ListView.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Padding="4" Spacing="2">
                                                            <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" />
                                                            <TextBlock FontSize="12" Foreground="{StaticResource TextMutedBrush}" Text="{Binding SecondaryLabel}" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ListView.ItemTemplate>
                                            </ListView>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                                <TextBlock x:Name="CameraStatusText" Foreground="{StaticResource TextMutedBrush}" Text="Select a Camera" />
                            </StackPanel>

                            <StackPanel Spacing="7">
                                <TextBlock FontWeight="SemiBold" Text="Printer" />
                                <ComboBox
                                    x:Name="PrinterComboBox"
                                    Width="370"
                                    HorizontalAlignment="Left"
                                    AutomationProperties.Name="Printer"
                                    PlaceholderText="Choose Printer"
                                    SelectionChanged="PrinterSelectionChanged">
                                    <ComboBoxItem Content="No Printer" />
                                </ComboBox>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,28,0,0" Spacing="8">
                            <TextBlock FontWeight="SemiBold" Text="Live preview" />
                            <Border
                                x:Name="PreviewViewport"
                                Height="392"
                                HorizontalAlignment="Left"
                                Background="#FF17181A"
                                CornerRadius="8">
                                <Grid>
                                    <Image x:Name="PreviewImage" Stretch="UniformToFill" RenderTransformOrigin="0.5,0.5" />
                                    <!-- The full preview viewport is the deterministic 3:2 Capture crop. -->
                                    <Border BorderBrush="White" BorderThickness="2" CornerRadius="5" Opacity="0.82" />
                                    <TextBlock
                                        Margin="12"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Bottom"
                                        Foreground="White"
                                        FontSize="12"
                                        Text="3:2 Capture area" />
                                </Grid>
                            </Border>
                        </StackPanel>

                        <Grid Grid.Row="2" Grid.ColumnSpan="3" Margin="0,24,0,0">
                            <Button Content="Cancel" Click="CancelSetupClicked" />
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="10">
                                <Button x:Name="SaveCloseButton" Content="Save &amp; Close" Click="SaveCloseClicked" IsEnabled="False" />
                                <Button x:Name="SaveStartButton" Content="Save &amp; Start Event" Click="SaveStartClicked" IsEnabled="False" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
