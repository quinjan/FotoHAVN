<Window
    x:Class="FotoHavn.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:FotoHavn.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="FotoHAVN">

    <Grid x:Name="WindowRoot" Background="#FF24262A">
        <Grid
            x:Name="FixedCanvas"
            Width="1280"
            Height="720"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="{StaticResource CanvasBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="54" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource HairlineBrush}"
                BorderThickness="0,0,0,1">
                <Grid Margin="17,0">
                    <StackPanel
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="10">
                        <Border
                            Width="20"
                            Height="20"
                            Background="#FF202124"
                            CornerRadius="5">
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground="White"
                                FontSize="12"
                                FontWeight="Bold"
                                Text="F" />
                        </Border>
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="15"
                            FontWeight="SemiBold"
                            Text="FotoHAVN" />
                    </StackPanel>
                    <TextBlock
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        CharacterSpacing="180"
                        FontSize="9"
                        FontWeight="Bold"
                        Text="OPERATOR CONSOLE" />
                </Grid>
            </Border>

            <ScrollViewer
                x:Name="EventScrollViewer"
                Grid.Row="1"
                HorizontalScrollBarVisibility="Disabled"
                HorizontalScrollMode="Disabled"
                VerticalScrollBarVisibility="Auto"
                VerticalScrollMode="Enabled"
                ZoomMode="Disabled">
                <ScrollViewer.Resources>
                    <SolidColorBrush x:Key="ScrollBarThumbFill" Color="#FFB6BBC2" />
                    <SolidColorBrush x:Key="ScrollBarThumbFillPointerOver" Color="#FF858B93" />
                    <SolidColorBrush x:Key="ScrollBarThumbFillPressed" Color="#FF5F656D" />
                    <SolidColorBrush x:Key="ScrollBarTrackFill" Color="Transparent" />
                    <SolidColorBrush x:Key="ScrollBarTrackFillPointerOver" Color="#12000000" />
                    <SolidColorBrush x:Key="ScrollBarPanningThumbBackground" Color="#FFB6BBC2" />
                </ScrollViewer.Resources>
                <StackPanel
                    Width="1012"
                    Padding="0,48,0,56"
                    HorizontalAlignment="Center">
                    <TextBlock
                        CharacterSpacing="180"
                        FontSize="9"
                        FontWeight="Bold"
                        Text="SAVED EVENTS" />
                    <TextBlock
                        x:Name="HeadingText"
                        Margin="0,10,0,0"
                        FontSize="32"
                        FontWeight="Bold"
                        Text="Choose an Event" />
                    <TextBlock
                        Margin="0,4,0,0"
                        Foreground="{StaticResource TextMutedBrush}"
                        FontSize="15"
                        Text="Open one to adjust its setup, or start a Guest Cycle." />

                    <ItemsControl
                        x:Name="EventTiles"
                        Width="1026"
                        Margin="0,36,0,0"
                        HorizontalAlignment="Left">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="3" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="core:EventTilePresentation">
                            <Grid
                                Width="328"
                                Height="188"
                                Margin="0,0,14,14">
                                <Button
                                    AutomationProperties.Name="{x:Bind Label}"
                                    Click="EventTileClicked"
                                    Style="{StaticResource EventTileButtonStyle}"
                                    Visibility="{x:Bind ShowsCreate}">
                                    <Button.Resources>
                                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#FFF1F2F4" />
                                        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#FFE8EAED" />
                                        <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#FFC8CCD2" />
                                        <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#FFBFC4CB" />
                                    </Button.Resources>
                                    <StackPanel
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Spacing="10">
                                        <Border
                                            Width="36"
                                            Height="36"
                                            HorizontalAlignment="Center"
                                            Background="#FF1C1D1F"
                                            CornerRadius="18">
                                            <FontIcon
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontFamily="Segoe MDL2 Assets"
                                                FontSize="16"
                                                Foreground="White"
                                                Glyph="&#xE710;" />
                                        </Border>
                                        <StackPanel HorizontalAlignment="Center" Spacing="6">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                FontSize="15"
                                                FontWeight="Bold"
                                                Text="{x:Bind Label}" />
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                Foreground="{StaticResource TextMutedBrush}"
                                                FontSize="11"
                                                Text="{x:Bind SupportingText}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Button>

                                <Border
                                    x:Name="SavedEventCard"
                                    Padding="24"
                                    Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource HairlineBrush}"
                                    BorderThickness="1"
                                    CornerRadius="9"
                                    PointerEntered="SavedEventCardPointerEntered"
                                    PointerExited="SavedEventCardPointerExited"
                                    Visibility="{x:Bind ShowsStart}">
                                    <Grid>
                                        <StackPanel
                                            x:Name="SavedEventMetadata"
                                            Margin="0,0,46,0"
                                            VerticalAlignment="Bottom"
                                            Spacing="5">
                                            <TextBlock
                                                FontSize="15"
                                                FontWeight="Bold"
                                                Text="{x:Bind Label}"
                                                TextTrimming="CharacterEllipsis"
                                                ToolTipService.ToolTip="{x:Bind Label}" />
                                            <TextBlock
                                                Foreground="{StaticResource TextMutedBrush}"
                                                FontSize="11"
                                                Text="{x:Bind SupportingText}"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <Button
                                            x:Name="StartEventButton"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            AutomationProperties.Name="Start Event"
                                            Click="StartSavedEventClicked"
                                            GotFocus="StartEventButtonGotFocus"
                                            LostFocus="StartEventButtonLostFocus"
                                            Opacity="0"
                                            Style="{StaticResource EventStartButtonStyle}"
                                            Visibility="{x:Bind ShowsStart}">
                                            <Button.Resources>
                                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="Transparent" />
                                                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="Transparent" />
                                                <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
                                                <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
                                            </Button.Resources>
                                            <StackPanel HorizontalAlignment="Center" Spacing="7">
                                                <FontIcon
                                                    HorizontalAlignment="Center"
                                                    FontFamily="Segoe MDL2 Assets"
                                                    FontSize="26"
                                                    Glyph="&#xF5B0;" />
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    FontSize="12"
                                                    Text="Start Event" />
                                            </StackPanel>
                                        </Button>

                                        <Button
                                            Margin="0,-12,-12,0"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            AutomationProperties.Name="Delete Event"
                                            Click="DeleteSavedEventClicked"
                                            Foreground="{StaticResource DangerBrush}"
                                            Style="{StaticResource EventActionButtonStyle}"
                                            Visibility="{x:Bind ShowsDelete}">
                                            <FontIcon
                                                FontFamily="Segoe MDL2 Assets"
                                                FontSize="12"
                                                Glyph="&#xE74D;" />
                                        </Button>

                                        <Button
                                            Margin="0,0,-12,-12"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Bottom"
                                            AutomationProperties.Name="Edit Event"
                                            Click="EditSavedEventClicked"
                                            Style="{StaticResource EventActionButtonStyle}"
                                            Visibility="{x:Bind ShowsEdit}">
                                            <FontIcon
                                                FontFamily="Segoe MDL2 Assets"
                                                FontSize="12"
                                                Glyph="&#xE713;" />
                                        </Button>
                                    </Grid>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <Grid
                x:Name="ActiveEventLayer"
                Grid.RowSpan="2"
                Background="{StaticResource CanvasBrush}"
                Visibility="Collapsed">
                <Grid x:Name="StartGuestLayer">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="58" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border
                        Background="#D1FFFFFF"
                        BorderBrush="{StaticResource HairlineBrush}"
                        BorderThickness="0,0,0,1">
                        <Grid Margin="28,0,19,0">
                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="10">
                                <Border Width="22" Height="22" Background="#FF202124" CornerRadius="5">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Foreground="White"
                                        FontSize="13"
                                        FontWeight="Bold"
                                        Text="F" />
                                </Border>
                                <TextBlock VerticalAlignment="Center" FontSize="15" FontWeight="Bold" Text="FotoHAVN" />
                            </StackPanel>
                            <Button
                                x:Name="ExitEventButton"
                                MinWidth="96"
                                MinHeight="44"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="Exit Event"
                                Background="Transparent"
                                BorderThickness="0"
                                Click="ExitEventClicked">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <FontIcon FontFamily="Segoe MDL2 Assets" FontSize="14" Glyph="&#xE7E8;" />
                                    <TextBlock VerticalAlignment="Center" FontSize="12" Text="Exit Event" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                    <StackPanel
                        Grid.Row="1"
                        Width="780"
                        Padding="0,0,0,28"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="0">
                        <TextBlock
                            x:Name="ActiveEventNameText"
                            HorizontalAlignment="Center"
                            CharacterSpacing="150"
                            FontSize="10"
                            FontWeight="Bold"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                        <TextBlock
                            x:Name="ActiveEventHeadingText"
                            Margin="0,17,0,0"
                            HorizontalAlignment="Center"
                            CharacterSpacing="-40"
                            FontSize="60"
                            FontWeight="Bold"
                            AutomationProperties.HeadingLevel="Level1"
                            TextAlignment="Center" />
                        <TextBlock
                            x:Name="ActiveEventExplanationText"
                            Margin="0,13,0,0"
                            HorizontalAlignment="Center"
                            Foreground="{StaticResource TextMutedBrush}"
                            FontSize="16"
                            TextAlignment="Center" />
                        <Button
                            x:Name="StartGuestCycleButton"
                            MinWidth="204"
                            MinHeight="68"
                            Margin="0,33,0,0"
                            HorizontalAlignment="Center"
                            HorizontalContentAlignment="Center"
                            AutomationProperties.Name="Touch to start"
                            Background="Black"
                            BorderBrush="Black"
                            BorderThickness="1"
                            Click="StartGuestCycleClicked"
                            CornerRadius="9"
                            FocusVisualPrimaryThickness="3"
                            FocusVisualSecondaryThickness="0"
                            FontSize="17"
                            FontWeight="SemiBold"
                            Foreground="White">
                            <Button.Resources>
                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#FF000000" />
                                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#FF1C1D1F" />
                                <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FFFFFFFF" />
                                <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#FFFFFFFF" />
                                <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#FF000000" />
                                <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#FF1C1D1F" />
                            </Button.Resources>
                            <StackPanel Orientation="Horizontal" Spacing="11">
                                <FontIcon FontFamily="Segoe MDL2 Assets" FontSize="19" Glyph="&#xE768;" />
                                <TextBlock VerticalAlignment="Center" Foreground="White" Text="Touch to start" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <TextBlock
                        Grid.Row="1"
                        Margin="0,0,0,66"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Foreground="#FF8B8E92"
                        FontSize="10"
                        Text="Photos stay with this Event." />
                </Grid>

                <Grid x:Name="GuestCaptureLayer" Padding="24,20,24,42" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="43" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Width="22" Height="22" Background="#FF202124" CornerRadius="5">
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" FontSize="13" FontWeight="Bold" Text="F" />
                        </Border>
                        <TextBlock VerticalAlignment="Center" FontSize="15" FontWeight="Bold" Text="FotoHAVN" />
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="12">
                        <TextBlock
                            x:Name="CaptureProgressText"
                            VerticalAlignment="Center"
                            CharacterSpacing="100"
                            FontSize="10"
                            FontWeight="Bold" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border x:Name="CaptureStep1Border" Width="32" Height="32" Background="White" BorderBrush="#FFC7CACE" BorderThickness="1" CornerRadius="16">
                                <Grid><TextBlock x:Name="CaptureStep1Number" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Text="1" /><FontIcon x:Name="CaptureStep1Check" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="13" Glyph="&#xE73E;" Visibility="Collapsed" /></Grid>
                            </Border>
                            <Border x:Name="CaptureStep2Border" Width="32" Height="32" Background="White" BorderBrush="#FFC7CACE" BorderThickness="1" CornerRadius="16">
                                <Grid><TextBlock x:Name="CaptureStep2Number" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Text="2" /><FontIcon x:Name="CaptureStep2Check" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="13" Glyph="&#xE73E;" Visibility="Collapsed" /></Grid>
                            </Border>
                            <Border x:Name="CaptureStep3Border" Width="32" Height="32" Background="White" BorderBrush="#FFC7CACE" BorderThickness="1" CornerRadius="16">
                                <Grid><TextBlock x:Name="CaptureStep3Number" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Text="3" /><FontIcon x:Name="CaptureStep3Check" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="13" Glyph="&#xE73E;" Visibility="Collapsed" /></Grid>
                            </Border>
                            <Border x:Name="CaptureStep4Border" Width="32" Height="32" Background="White" BorderBrush="#FFC7CACE" BorderThickness="1" CornerRadius="16">
                                <Grid><TextBlock x:Name="CaptureStep4Number" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Text="4" /><FontIcon x:Name="CaptureStep4Check" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="13" Glyph="&#xE73E;" Visibility="Collapsed" /></Grid>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                    <Border
                        Grid.Row="1"
                        Width="922.5"
                        HorizontalAlignment="Center"
                        Background="#FF17181A"
                        BorderBrush="#FFBFC3C7"
                        BorderThickness="1"
                        CornerRadius="10">
                        <Grid>
                            <Image x:Name="GuestPreviewImage" RenderTransformOrigin="0.5,0.5" Stretch="UniformToFill">
                                <Image.RenderTransform><ScaleTransform ScaleX="-1" /></Image.RenderTransform>
                            </Image>
                            <Border
                                Margin="0,17,17,0"
                                Padding="9,7"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Background="#E6FFFFFF"
                                CornerRadius="6">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <FontIcon FontFamily="Segoe MDL2 Assets" FontSize="13" Glyph="&#xE722;" />
                                    <TextBlock CharacterSpacing="90" FontSize="9" FontWeight="Bold" Text="LIVE · MIRRORED" />
                                </StackPanel>
                            </Border>
                            <Grid x:Name="CountdownOverlay" Background="#1A0F1011">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock HorizontalAlignment="Center" CharacterSpacing="200" Foreground="White" FontSize="13" FontWeight="Bold" Text="GET READY" />
                                    <TextBlock x:Name="CountdownText" HorizontalAlignment="Center" Foreground="White" FontSize="190" FontWeight="Bold" Text="5" />
                                </StackPanel>
                            </Grid>
                            <Grid x:Name="FlashOverlay" Background="White" Visibility="Collapsed" />
                            <Border
                                x:Name="CaptureSavedOverlay"
                                MinWidth="240"
                                MinHeight="65"
                                Margin="0,0,0,38"
                                Padding="20,10"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Bottom"
                                Background="#E6121314"
                                CornerRadius="9"
                                Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="White" Glyph="&#xE73E;" />
                                    <StackPanel><TextBlock Foreground="White" FontSize="14" FontWeight="SemiBold" Text="Capture saved" /><TextBlock Foreground="#FFD9DBDD" FontSize="10" Text="Get ready for the next one" /></StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <Grid
                    x:Name="GuestAssistanceLayer"
                    Padding="28"
                    AutomationProperties.LiveSetting="Assertive"
                    Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Width="22" Height="22" Background="#FF202124" CornerRadius="5"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" FontSize="13" FontWeight="Bold" Text="F" /></Border>
                        <TextBlock VerticalAlignment="Center" FontSize="15" FontWeight="Bold" Text="FotoHAVN" />
                    </StackPanel>
                    <Button
                        x:Name="AssistanceExitEventButton"
                        MinWidth="96"
                        MinHeight="44"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        AutomationProperties.Name="Exit Event"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="ExitEventClicked"
                        Content="Exit Event" />
                    <StackPanel Width="600" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Width="52" Height="52" HorizontalAlignment="Center" Background="#FFFFF0EE" CornerRadius="26">
                            <FontIcon HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="25" Foreground="#FFC7362F" Glyph="&#xEA39;" />
                        </Border>
                        <TextBlock x:Name="AssistanceEyebrowText" Margin="0,24,0,0" HorizontalAlignment="Center" CharacterSpacing="150" FontSize="10" FontWeight="Bold" Text="WE PAUSED YOUR PHOTOS" />
                        <TextBlock Margin="0,16,0,0" HorizontalAlignment="Center" AutomationProperties.HeadingLevel="Level1" CharacterSpacing="-40" FontSize="48" FontWeight="Bold" Text="Please call the operator." />
                        <TextBlock x:Name="AssistanceMessageText" Margin="0,12,0,0" HorizontalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" FontSize="15" TextAlignment="Center" TextWrapping="Wrap" />
                        <Border Width="365" Margin="0,28,0,0" Padding="14" HorizontalAlignment="Center" Background="White" BorderBrush="#FFE0AAA5" BorderThickness="1" CornerRadius="8">
                            <StackPanel Orientation="Horizontal" Spacing="13">
                                <Border Width="36" Height="36" Background="#FFFFF0EE" CornerRadius="7"><FontIcon HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#FFC7362F" Glyph="&#xE722;" /></Border>
                                <StackPanel><TextBlock x:Name="AssistanceDetailTitle" FontSize="12" FontWeight="SemiBold" /><TextBlock x:Name="AssistanceProgressText" Margin="0,4,0,0" Foreground="{StaticResource TextMutedBrush}" FontSize="10" /></StackPanel>
                            </StackPanel>
                        </Border>
                        <Button
                            MinWidth="160"
                            MinHeight="68"
                            Margin="0,24,0,0"
                            HorizontalAlignment="Center"
                            AutomationProperties.Name="Retry"
                            Background="Black"
                            BorderBrush="Black"
                            Click="RetryGuestCycleClicked"
                            CornerRadius="9"
                            FocusVisualPrimaryThickness="3"
                            FocusVisualSecondaryThickness="0"
                            Foreground="White">
                            <Button.Resources>
                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#FF000000" />
                                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#FF1C1D1F" />
                                <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FFFFFFFF" />
                                <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#FFFFFFFF" />
                                <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#FF000000" />
                                <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#FF1C1D1F" />
                            </Button.Resources>
                            <StackPanel Orientation="Horizontal" Spacing="11"><FontIcon FontFamily="Segoe MDL2 Assets" FontSize="19" Glyph="&#xE72C;" /><TextBlock VerticalAlignment="Center" Foreground="White" FontSize="17" FontWeight="SemiBold" Text="Retry" /></StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <Grid x:Name="PhotoStripLayer" Padding="120,46" Visibility="Collapsed">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="420" /></Grid.ColumnDefinitions>
                    <StackPanel Width="520" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <TextBlock CharacterSpacing="150" FontSize="10" FontWeight="Bold" Text="ALL FOUR CAPTURES SAVED" />
                        <TextBlock Margin="0,17,0,0" AutomationProperties.HeadingLevel="Level1" CharacterSpacing="-40" FontSize="50" FontWeight="Bold" Text="Here’s your Photo Strip." />
                        <TextBlock x:Name="PhotoStripReturnText" Margin="0,14,0,0" Foreground="{StaticResource TextMutedBrush}" FontSize="15" TextWrapping="Wrap" />
                        <Grid Width="310" Height="3" Margin="0,30,0,0" HorizontalAlignment="Left" Background="#FFD8DADE">
                            <Border x:Name="ReturnProgressFill" Width="310" HorizontalAlignment="Left" Background="#FF1C1D1F" />
                        </Grid>
                    </StackPanel>
                    <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Background="White">
                        <Border.RenderTransform><RotateTransform Angle="1.5" /></Border.RenderTransform>
                        <Image x:Name="PhotoStripImage" Width="190" Height="570" Stretch="Uniform" />
                    </Border>
                </Grid>

                <Grid
                    x:Name="ExitEventConfirmationLayer"
                    Background="#8A17181A"
                    Visibility="Collapsed">
                    <Border
                        Width="440"
                        Padding="28"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="{StaticResource SurfaceBrush}"
                        CornerRadius="12">
                        <StackPanel Spacing="20">
                            <TextBlock FontSize="24" FontWeight="SemiBold" Text="Exit Event?" />
                            <TextBlock
                                Foreground="{StaticResource TextMutedBrush}"
                                Text="The Camera will be released and FotoHAVN will return to Saved Events."
                                TextWrapping="Wrap" />
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="10">
                                <Button Click="CancelExitEventClicked" Content="Keep Event Active" />
                                <Button
                                    Click="ConfirmExitEventClicked"
                                    Background="{StaticResource DangerBrush}"
                                    Content="Exit Event"
                                    Foreground="White" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <Grid
                x:Name="StartEventConfirmationLayer"
                Grid.RowSpan="2"
                Background="#8A17181A"
                Visibility="Collapsed">
                <Border
                    Width="440"
                    Padding="28"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{StaticResource SurfaceBrush}"
                    CornerRadius="12">
                    <StackPanel Spacing="20">
                        <TextBlock
                            x:Name="StartEventConfirmationText"
                            FontSize="24"
                            FontWeight="SemiBold"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Foreground="{StaticResource TextMutedBrush}"
                            Text="FotoHAVN will confirm the Camera bound to this Event and storage before starting."
                            TextWrapping="Wrap" />
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="10">
                            <Button Click="CancelStartEventClicked" Content="Cancel" />
                            <Button
                                Click="ConfirmStartEventClicked"
                                Background="#FF111214"
                                Content="Start Event"
                                Foreground="White" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid
                x:Name="SetupLayer"
                Grid.RowSpan="2"
                Background="#8A17181A"
                Visibility="Collapsed">
                <Border
                    x:Name="SetupDialog"
                    Width="1100"
                    Height="640"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{StaticResource SurfaceBrush}"
                    CornerRadius="14"
                    KeyDown="SetupLayerKeyDown">
                    <Grid Padding="34">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="410" />
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.ColumnSpan="3" Spacing="4">
                            <TextBlock
                                CharacterSpacing="180"
                                FontSize="9"
                                FontWeight="Bold"
                                Text="EVENT SETUP" />
                            <TextBlock
                                x:Name="SetupTitleText"
                                Margin="0,6,0,0"
                                FontSize="28"
                                FontWeight="SemiBold"
                                Text="New Event" />
                            <TextBlock
                                Foreground="{StaticResource TextMutedBrush}"
                                Text="Name the Event and choose its Camera and Printer." />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Margin="0,28,0,0" Spacing="12">
                            <Border
                                Width="410"
                                Padding="16"
                                HorizontalAlignment="Left"
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource HairlineBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                                <StackPanel Spacing="18">
                                    <StackPanel Spacing="6">
                                        <TextBlock FontWeight="SemiBold" Text="Event name" />
                                        <Grid Width="370" HorizontalAlignment="Left">
                                            <TextBox
                                                x:Name="EventNameTextBox"
                                                Width="370"
                                                AutomationProperties.Name="Event name"
                                                PlaceholderText="Enter Event name"
                                                TextChanged="EventNameTextChanged" />
                                            <Border
                                                x:Name="NameDirtyIndicator"
                                                Width="3"
                                                Margin="1"
                                                HorizontalAlignment="Left"
                                                Background="{StaticResource FocusVisualPrimaryBrush}"
                                                CornerRadius="5,0,0,5"
                                                IsHitTestVisible="False"
                                                Visibility="Collapsed" />
                                        </Grid>
                                        <TextBlock
                                            Foreground="{StaticResource TextMutedBrush}"
                                            FontSize="11"
                                            Text="Names do not need to be unique." />
                                    </StackPanel>

                                    <StackPanel Spacing="6">
                                        <TextBlock FontWeight="SemiBold" Text="Camera" />
                                        <Grid Width="370" HorizontalAlignment="Left">
                                            <ComboBox
                                                x:Name="CameraComboBox"
                                                Width="370"
                                                AutomationProperties.Name="Camera"
                                                DisplayMemberPath="DisplayName"
                                                MaxDropDownHeight="230"
                                                PlaceholderText="Select Camera"
                                                SelectionChanged="CameraSelectionChanged" />
                                            <Border
                                                x:Name="CameraDirtyIndicator"
                                                Width="3"
                                                Margin="1"
                                                HorizontalAlignment="Left"
                                                Background="{StaticResource FocusVisualPrimaryBrush}"
                                                CornerRadius="5,0,0,5"
                                                IsHitTestVisible="False"
                                                Visibility="Collapsed" />
                                        </Grid>
                                        <TextBlock
                                            Foreground="{StaticResource TextMutedBrush}"
                                            FontSize="11"
                                            Text="Only available Cameras are shown." />
                                    </StackPanel>

                                    <StackPanel Spacing="6">
                                        <TextBlock FontWeight="SemiBold" Text="Printer" />
                                        <ComboBox
                                            x:Name="PrinterComboBox"
                                            Width="370"
                                            HorizontalAlignment="Left"
                                            AutomationProperties.HelpText="Printing is optional for this Event."
                                            AutomationProperties.Name="Printer"
                                            PlaceholderText="Choose Printer"
                                            SelectionChanged="PrinterSelectionChanged">
                                            <ComboBoxItem Content="No Printer" />
                                        </ComboBox>
                                        <TextBlock
                                            Foreground="{StaticResource TextMutedBrush}"
                                            FontSize="11"
                                            Text="Printing is optional for this Event." />
                                        <TextBlock
                                            x:Name="StorageStatusText"
                                            Foreground="{StaticResource DangerBrush}"
                                            FontSize="11"
                                            Text="Event storage is not writable. Nothing was saved or started."
                                            TextWrapping="Wrap"
                                            Visibility="Collapsed" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border
                                x:Name="SetupFailureBorder"
                                Padding="12"
                                Background="#FFFFF4F2"
                                BorderBrush="#FFD58B82"
                                BorderThickness="1"
                                CornerRadius="7"
                                Visibility="Collapsed">
                                <StackPanel Spacing="10">
                                    <TextBlock
                                        x:Name="SetupFailureText"
                                        Foreground="#FF74342D"
                                        TextWrapping="Wrap" />
                                    <Button
                                        x:Name="RetryStorageButton"
                                        HorizontalAlignment="Left"
                                        Click="RetryStorageClicked"
                                        Content="Check storage again"
                                        Visibility="Collapsed" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,28,0,0" Spacing="8">
                            <TextBlock FontWeight="SemiBold" Text="Live preview" />
                            <Border
                                x:Name="PreviewViewport"
                                Height="392"
                                HorizontalAlignment="Left"
                                Background="#FF17181A"
                                CornerRadius="8">
                                <Grid>
                                    <Grid x:Name="PreviewSurface">
                                        <Image
                                            x:Name="PreviewImage"
                                            AutomationProperties.HelpText="Mirrored preview of the 3:2 Capture area."
                                            AutomationProperties.Name="Live preview from the selected Camera"
                                            Stretch="UniformToFill" />
                                    </Grid>
                                    <!-- The full preview viewport is the deterministic 3:2 Capture crop. -->
                                    <Border BorderBrush="White" BorderThickness="2" CornerRadius="5" Opacity="0.82" />
                                    <TextBlock
                                        Margin="12"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Bottom"
                                        Foreground="White"
                                        FontSize="12"
                                        Text="3:2 Capture area" />
                                </Grid>
                            </Border>
                        </StackPanel>

                        <Grid Grid.Row="2" Grid.ColumnSpan="3" Margin="0,24,0,0">
                            <Button Content="Cancel" Click="CancelSetupClicked" Style="{StaticResource ModalTextButtonStyle}" />
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="10">
                                <Button x:Name="SaveCloseButton" Content="Save &amp; Close" Click="SaveCloseClicked" IsEnabled="False" Style="{StaticResource ModalOutlineButtonStyle}" />
                                <Button x:Name="SaveStartButton" Content="Save &amp; Start Event" Click="SaveStartClicked" IsEnabled="False" Style="{StaticResource ModalPrimaryButtonStyle}" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <Grid
                    x:Name="DiscardDraftLayer"
                    Background="#B817181A"
                    Visibility="Collapsed">
                    <Border
                        Width="430"
                        Padding="28"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="{StaticResource SurfaceBrush}"
                        CornerRadius="12">
                        <StackPanel Spacing="18">
                            <TextBlock x:Name="DiscardTitleText" FontSize="24" FontWeight="SemiBold" Text="Discard this draft?" />
                            <TextBlock
                                Foreground="{StaticResource TextMutedBrush}"
                                Text="Your unsaved Event changes will be lost."
                                TextWrapping="Wrap" />
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="10">
                                <Button Content="Keep Editing" Click="KeepEditingClicked" Style="{StaticResource ModalTextButtonStyle}" />
                                <Button x:Name="DiscardActionButton" Content="Discard Draft" Click="DiscardDraftClicked" Style="{StaticResource ModalDangerButtonStyle}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid
                    x:Name="SaveChangesLayer"
                    Background="#B817181A"
                    Visibility="Collapsed">
                    <Border
                        Width="500"
                        Padding="28"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="{StaticResource SurfaceBrush}"
                        CornerRadius="12">
                        <StackPanel Spacing="18">
                            <TextBlock FontSize="24" FontWeight="SemiBold" Text="Save Event changes?" />
                            <TextBlock
                                Foreground="{StaticResource TextMutedBrush}"
                                Text="The new Event name and Camera Binding affect only future Guest Cycles. Completed Guest Cycles and their artifacts will not change."
                                TextWrapping="Wrap" />
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="10">
                                <Button Content="Keep Editing" Click="CancelSaveClicked" Style="{StaticResource ModalTextButtonStyle}" />
                                <Button x:Name="ConfirmSaveButton" Content="Save Changes" Click="ConfirmSaveClicked" Style="{StaticResource ModalPrimaryButtonStyle}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
