<UserControl
    x:Class="FotoHavn.App.Controls.CameraViewport"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    AutomationProperties.AutomationId="FotoHavn.CameraViewport"
    AutomationProperties.Name="Camera preview"
    Style="{StaticResource FotoHavnCameraViewportStyle}">
    <Border Style="{StaticResource FotoHavnCameraViewportPanelStyle}">
        <Grid>
            <Image
                x:Name="PreviewImage"
                AutomationProperties.AccessibilityView="Raw"
                Source="{x:Bind Source, Mode=OneWay}"
                Stretch="UniformToFill" />
            <Border
                x:Name="CaptureGuide"
                AutomationProperties.Name="Photo capture area"
                IsHitTestVisible="False"
                Style="{StaticResource FotoHavnCaptureGuideStyle}" />
            <TextBlock
                x:Name="StatusText"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Foreground="{ThemeResource ColorActionPrimaryForegroundBrush}"
                Style="{StaticResource TypeCaptionStyle}"
                Text="{x:Bind Status, Mode=OneWay}" />
            <ContentPresenter Content="{x:Bind OverlayContent, Mode=OneWay}" />
        </Grid>
    </Border>
</UserControl>
