<UserControl
    x:Class="FotoHavn.App.Controls.EventCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    AutomationProperties.AutomationId="FotoHavn.EventCard"
    DataContextChanged="EventCardDataContextChanged"
    Style="{StaticResource FotoHavnEventCardStyle}">
    <Grid>
        <Button
            x:Name="NewEventButton"
            AutomationProperties.Name="New Event"
            Click="NewEventClicked"
            Content="New Event"
            Style="{StaticResource FotoHavnActionButtonPrimaryStyle}"
            Visibility="Collapsed" />
        <Border
            x:Name="SavedEventCardRoot"
            Style="{StaticResource FotoHavnEventCardPanelStyle}"
            Visibility="Collapsed">
            <Grid>
                <Button
                    x:Name="StartButton"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    AutomationProperties.HelpText="Start Event"
                    Background="Transparent"
                    BorderThickness="{StaticResource StrokeNone}"
                    Click="StartClicked"
                    Content=""
                    CornerRadius="{StaticResource RadiusPanel}"
                    FocusVisualMargin="-4">
                    <Button.Resources>
                        <SolidColorBrush x:Key="ButtonBackground" Color="Transparent" />
                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#FFFAFAFB" />
                        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#FFF1F2F4" />
                        <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent" />
                        <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
                        <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
                        <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="Transparent" />
                    </Button.Resources>
                </Button>
            <Grid x:Name="CardLayout">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="CardActionsColumn" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    x:Name="EventNameText"
                    AutomationProperties.HeadingLevel="Level2"
                    IsHitTestVisible="False"
                    Margin="0,0,0,16"
                    Style="{StaticResource TypeHeadingCardStyle}"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    Grid.Row="1"
                    IsHitTestVisible="False"
                    Style="{StaticResource TypeEyebrowStyle}"
                    Text="EVENT ID" />
                <TextBlock
                    x:Name="CompactEventIdText"
                    Grid.Row="2"
                    IsHitTestVisible="False"
                    Style="{StaticResource TypeBodyDefaultStyle}" />
                <TextBlock
                    x:Name="SavedMetadataText"
                    Grid.Row="3"
                    FontSize="{StaticResource EventCardMetadataFontSize}"
                    Foreground="{ThemeResource ColorTextMutedBrush}"
                    IsHitTestVisible="False"
                    Style="{StaticResource TypeCaptionStyle}" />
                <Grid x:Name="CardActions" Grid.Row="4">
                    <StackPanel
                        x:Name="CardStatus"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        IsHitTestVisible="False"
                        Orientation="Horizontal"
                        Spacing="{StaticResource EventCardStatusSpacing}"
                        Visibility="Collapsed">
                        <ProgressRing
                            x:Name="CardProgressRing"
                            Width="{StaticResource EventCardStatusIconSize}"
                            Height="{StaticResource EventCardStatusIconSize}"
                            IsActive="False"
                            Visibility="Collapsed" />
                        <TextBlock
                            x:Name="CardStatusText"
                            VerticalAlignment="Center"
                            FontSize="{StaticResource EventCardStatusFontSize}" />
                    </StackPanel>
                    <StackPanel AutomationProperties.Name="Start, Edit, and Delete actions" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="{StaticResource SpaceInline}">
                        <Button
                            x:Name="RetryButton"
                            Click="RetryClicked"
                            Content="Retry Deletion"
                            Style="{StaticResource FotoHavnActionButtonSecondaryStyle}"
                            Visibility="Collapsed" />
                        <Button
                            x:Name="EditButton"
                            Click="EditClicked"
                            ToolTipService.ToolTip="Edit Event"
                            Style="{StaticResource FotoHavnIconActionStyle}">
                            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE70F;" />
                        </Button>
                        <Button
                            x:Name="DeleteButton"
                            Click="DeleteClicked"
                            ToolTipService.ToolTip="Delete Event"
                            Style="{StaticResource FotoHavnIconActionDestructiveStyle}">
                            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE74D;" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
