<UserControl
    x:Class="FotoHavn.App.Controls.StatusCallout"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border
        x:Name="CalloutFrame"
        Padding="{StaticResource StatusContentPadding}"
        BorderThickness="{StaticResource StrokeDefault}"
        CornerRadius="{StaticResource RadiusPanel}">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="SeverityStates">
                <VisualState x:Name="Neutral">
                    <VisualState.Setters>
                        <Setter Target="CalloutFrame.Background" Value="{ThemeResource ColorSurfacePanelBrush}" />
                        <Setter Target="CalloutFrame.BorderBrush" Value="{ThemeResource ColorBorderDefaultBrush}" />
                        <Setter Target="CalloutIcon.Foreground" Value="{ThemeResource ColorTextMutedBrush}" />
                        <Setter Target="CalloutIcon.Glyph" Value="&#xE946;" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Info">
                    <VisualState.Setters>
                        <Setter Target="CalloutFrame.Background" Value="{ThemeResource ColorStatusInfoSurfaceBrush}" />
                        <Setter Target="CalloutFrame.BorderBrush" Value="{ThemeResource ColorStatusInfoBorderBrush}" />
                        <Setter Target="CalloutIcon.Foreground" Value="{ThemeResource ColorStatusInfoForegroundBrush}" />
                        <Setter Target="CalloutIcon.Glyph" Value="&#xE946;" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Success">
                    <VisualState.Setters>
                        <Setter Target="CalloutFrame.Background" Value="{ThemeResource ColorStatusSuccessSurfaceBrush}" />
                        <Setter Target="CalloutFrame.BorderBrush" Value="{ThemeResource ColorStatusSuccessBorderBrush}" />
                        <Setter Target="CalloutIcon.Foreground" Value="{ThemeResource ColorStatusSuccessForegroundBrush}" />
                        <Setter Target="CalloutIcon.Glyph" Value="&#xE73E;" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Warning">
                    <VisualState.Setters>
                        <Setter Target="CalloutFrame.Background" Value="{ThemeResource ColorStatusWarningSurfaceBrush}" />
                        <Setter Target="CalloutFrame.BorderBrush" Value="{ThemeResource ColorStatusWarningBorderBrush}" />
                        <Setter Target="CalloutIcon.Foreground" Value="{ThemeResource ColorStatusWarningForegroundBrush}" />
                        <Setter Target="CalloutIcon.Glyph" Value="&#xE7BA;" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Danger">
                    <VisualState.Setters>
                        <Setter Target="CalloutFrame.Background" Value="{ThemeResource ColorStatusDangerSurfaceBrush}" />
                        <Setter Target="CalloutFrame.BorderBrush" Value="{ThemeResource ColorStatusDangerBorderBrush}" />
                        <Setter Target="CalloutIcon.Foreground" Value="{ThemeResource ColorStatusDangerForegroundBrush}" />
                        <Setter Target="CalloutIcon.Glyph" Value="&#xEA39;" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid ColumnSpacing="{StaticResource SpaceInline}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{StaticResource IconDefault}" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <FontIcon
                x:Name="CalloutIcon"
                FontFamily="Segoe MDL2 Assets"
                FontSize="{StaticResource IconSmall}"
                AutomationProperties.AccessibilityView="Raw" />
            <StackPanel Grid.Column="1" Spacing="{StaticResource SpaceInline}">
                <TextBlock
                    AutomationProperties.AccessibilityView="Raw"
                    Style="{StaticResource TypeLabelControlStyle}"
                    Text="{x:Bind Title, Mode=OneWay}"
                    TextWrapping="Wrap" />
                <TextBlock
                    AutomationProperties.AccessibilityView="Raw"
                    Style="{StaticResource TypeBodyDefaultStyle}"
                    Text="{x:Bind Message, Mode=OneWay}"
                    TextWrapping="Wrap" />
                <ContentPresenter Content="{x:Bind Action, Mode=OneWay}" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
