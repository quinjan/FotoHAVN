<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:FotoHavn.App.Controls">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="ColorSurfaceCanvasBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="ColorSurfacePanelBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="ColorSurfaceRaisedBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="ColorSurfaceHoverBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="ColorSurfaceMediaBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="ColorTextPrimaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="ColorTextMutedBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="ColorTextInverseBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="ColorTextDisabledBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
            <SolidColorBrush x:Key="ColorBorderDefaultBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="ColorBorderStrongBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="ColorBorderDisabledBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
            <SolidColorBrush x:Key="ColorActionPrimaryIdleBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="ColorActionPrimaryHoverBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="ColorActionPrimaryPressedBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="ColorActionPrimaryDisabledBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
            <SolidColorBrush x:Key="ColorActionPrimaryForegroundBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="ColorActionSecondaryIdleBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="ColorActionSecondaryHoverBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="ColorActionSecondaryPressedBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="ColorActionSecondaryDisabledBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="ColorActionSecondaryForegroundBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="ColorActionSecondaryBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="ColorActionTertiaryIdleBrush" Color="Transparent" />
            <SolidColorBrush x:Key="ColorActionTertiaryHoverBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="ColorActionTertiaryPressedBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="ColorActionTertiaryDisabledBrush" Color="Transparent" />
            <SolidColorBrush x:Key="ColorActionTertiaryForegroundBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="ColorActionDestructiveIdleBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="ColorActionDestructiveHoverBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="ColorActionDestructivePressedBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="ColorActionDestructiveDisabledBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
            <SolidColorBrush x:Key="ColorActionDestructiveForegroundBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="ColorStatusInfoForegroundBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="ColorStatusInfoSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="ColorStatusInfoBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="ColorStatusSuccessForegroundBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="ColorStatusSuccessSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="ColorStatusSuccessBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="ColorStatusWarningForegroundBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="ColorStatusWarningSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="ColorStatusWarningBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="ColorStatusDangerForegroundBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="ColorStatusDangerSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="ColorStatusDangerBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="ColorFocusRingBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="ColorFocusSeparatorBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="ColorOverlayScrimBrush" Color="{ThemeResource SystemColorWindowColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <FontFamily x:Key="FotoHavnFontFamily">ms-appx:///Assets/Fonts/Inter-VariableFont_opsz,wght.ttf#Inter</FontFamily>

    <!-- Semantic color resources. These are the WinUI names governed by design-v1.0.1. -->
    <SolidColorBrush x:Key="ColorSurfaceCanvasBrush" Color="#FFF5F6F7" />
    <SolidColorBrush x:Key="ColorSurfacePanelBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="ColorSurfaceRaisedBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="ColorSurfaceHoverBrush" Color="#FFFAFAFB" />
    <SolidColorBrush x:Key="ColorSurfaceMediaBrush" Color="#FF17181A" />
    <SolidColorBrush x:Key="ColorTextPrimaryBrush" Color="#FF17181A" />
    <SolidColorBrush x:Key="ColorTextMutedBrush" Color="#FF686B70" />
    <SolidColorBrush x:Key="ColorTextInverseBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="ColorTextDisabledBrush" Color="#FF8B8E92" />
    <SolidColorBrush x:Key="ColorBorderDefaultBrush" Color="#FFD5D8DC" />
    <SolidColorBrush x:Key="ColorBorderStrongBrush" Color="#FF686B70" />
    <SolidColorBrush x:Key="ColorBorderDisabledBrush" Color="#FFE8EAED" />
    <SolidColorBrush x:Key="ColorActionPrimaryIdleBrush" Color="#FF17181A" />
    <SolidColorBrush x:Key="ColorActionPrimaryHoverBrush" Color="#FF111214" />
    <SolidColorBrush x:Key="ColorActionPrimaryPressedBrush" Color="#FF000000" />
    <SolidColorBrush x:Key="ColorActionPrimaryDisabledBrush" Color="#FFD5D8DC" />
    <SolidColorBrush x:Key="ColorActionPrimaryForegroundBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="ColorActionSecondaryIdleBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="ColorActionSecondaryHoverBrush" Color="#FFFAFAFB" />
    <SolidColorBrush x:Key="ColorActionSecondaryPressedBrush" Color="#FFF1F2F4" />
    <SolidColorBrush x:Key="ColorActionSecondaryDisabledBrush" Color="#FFF5F6F7" />
    <SolidColorBrush x:Key="ColorActionSecondaryForegroundBrush" Color="#FF17181A" />
    <SolidColorBrush x:Key="ColorActionSecondaryBorderBrush" Color="#FFD5D8DC" />
    <SolidColorBrush x:Key="ColorActionTertiaryIdleBrush" Color="Transparent" />
    <SolidColorBrush x:Key="ColorActionTertiaryHoverBrush" Color="#FFFAFAFB" />
    <SolidColorBrush x:Key="ColorActionTertiaryPressedBrush" Color="#FFF1F2F4" />
    <SolidColorBrush x:Key="ColorActionTertiaryDisabledBrush" Color="Transparent" />
    <SolidColorBrush x:Key="ColorActionTertiaryForegroundBrush" Color="#FF17181A" />
    <SolidColorBrush x:Key="ColorActionDestructiveIdleBrush" Color="#FFD4382E" />
    <SolidColorBrush x:Key="ColorActionDestructiveHoverBrush" Color="#FFA9231D" />
    <SolidColorBrush x:Key="ColorActionDestructivePressedBrush" Color="#FFA9231D" />
    <SolidColorBrush x:Key="ColorActionDestructiveDisabledBrush" Color="#FFD5D8DC" />
    <SolidColorBrush x:Key="ColorActionDestructiveForegroundBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="ColorStatusInfoForegroundBrush" Color="#FF2458D3" />
    <SolidColorBrush x:Key="ColorStatusInfoSurfaceBrush" Color="#FFF1F5FF" />
    <SolidColorBrush x:Key="ColorStatusInfoBorderBrush" Color="#FF9BB3EE" />
    <SolidColorBrush x:Key="ColorStatusSuccessForegroundBrush" Color="#FF287D3C" />
    <SolidColorBrush x:Key="ColorStatusSuccessSurfaceBrush" Color="#FFF1F8F3" />
    <SolidColorBrush x:Key="ColorStatusSuccessBorderBrush" Color="#FF91C79C" />
    <SolidColorBrush x:Key="ColorStatusWarningForegroundBrush" Color="#FF7A5900" />
    <SolidColorBrush x:Key="ColorStatusWarningSurfaceBrush" Color="#FFFFF8E6" />
    <SolidColorBrush x:Key="ColorStatusWarningBorderBrush" Color="#FFD5B65A" />
    <SolidColorBrush x:Key="ColorStatusDangerForegroundBrush" Color="#FF74342D" />
    <SolidColorBrush x:Key="ColorStatusDangerSurfaceBrush" Color="#FFFFF4F2" />
    <SolidColorBrush x:Key="ColorStatusDangerBorderBrush" Color="#FFD58B82" />
    <SolidColorBrush x:Key="ColorFocusRingBrush" Color="#FF2458D3" />
    <SolidColorBrush x:Key="ColorFocusSeparatorBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="ColorOverlayScrimBrush" Color="#8A17181A" />

    <!-- Typography roles. -->
    <Style x:Key="TypeDisplayCountdownStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FotoHavnFontFamily}" />
        <Setter Property="FontSize" Value="190" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="LineHeight" Value="190" />
    </Style>
    <Style x:Key="TypeDisplayGuestStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FotoHavnFontFamily}" />
        <Setter Property="FontSize" Value="48" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="LineHeight" Value="56" />
    </Style>
    <Style x:Key="TypeHeadingPageStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FotoHavnFontFamily}" />
        <Setter Property="FontSize" Value="32" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="LineHeight" Value="40" />
    </Style>
    <Style x:Key="TypeHeadingDialogStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FotoHavnFontFamily}" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LineHeight" Value="32" />
    </Style>
    <Style x:Key="TypeHeadingCardStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FotoHavnFontFamily}" />
        <Setter Property="FontSize" Value="21" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="LineHeight" Value="26" />
    </Style>
    <Style x:Key="TypeBodyDefaultStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FotoHavnFontFamily}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="LineHeight" Value="22" />
    </Style>
    <Style x:Key="TypeLabelControlStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FotoHavnFontFamily}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LineHeight" Value="20" />
    </Style>
    <Style x:Key="TypeCaptionStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FotoHavnFontFamily}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="LineHeight" Value="16" />
    </Style>
    <Style x:Key="TypeEyebrowStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FotoHavnFontFamily}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="LineHeight" Value="14" />
        <Setter Property="CharacterSpacing" Value="150" />
    </Style>

    <!-- Geometry, motion, elevation, and responsive thresholds. -->
    <x:Double x:Key="SpaceInline">8</x:Double>
    <x:Double x:Key="SpaceStackTight">8</x:Double>
    <x:Double x:Key="SpaceStackDefault">16</x:Double>
    <x:Double x:Key="SpaceSection">24</x:Double>
    <x:Double x:Key="SpaceControlHorizontal">16</x:Double>
    <x:Double x:Key="SpacePanel">24</x:Double>
    <x:Double x:Key="SpaceDialog">32</x:Double>
    <x:Double x:Key="SpacePage">48</x:Double>
    <CornerRadius x:Key="RadiusControl">4</CornerRadius>
    <CornerRadius x:Key="RadiusPanel">8</CornerRadius>
    <CornerRadius x:Key="RadiusDialog">12</CornerRadius>
    <CornerRadius x:Key="RadiusRound">9999</CornerRadius>
    <Thickness x:Key="StrokeDefault">1</Thickness>
    <Thickness x:Key="StrokeEmphasis">2</Thickness>
    <x:Double x:Key="IconSmall">16</x:Double>
    <x:Double x:Key="IconDefault">20</x:Double>
    <x:Double x:Key="IconLarge">24</x:Double>
    <x:Double x:Key="IconDisplay">32</x:Double>
    <x:Double x:Key="TargetOperatorMinimum">48</x:Double>
    <x:Double x:Key="TargetGuestProminent">64</x:Double>
    <x:Double x:Key="TargetSeparation">8</x:Double>
    <Thickness x:Key="FocusRingThickness">2</Thickness>
    <x:Double x:Key="FocusRingGap">2</x:Double>
    <ThemeShadow x:Key="ElevationDialogThemeShadow" />
    <Duration x:Key="MotionInstantDuration">0:0:0</Duration>
    <Duration x:Key="MotionFastDuration">0:0:0.12</Duration>
    <Duration x:Key="MotionStandardDuration">0:0:0.2</Duration>
    <Duration x:Key="MotionSlowDuration">0:0:0.3</Duration>
    <CubicEase x:Key="MotionStandardEasing" EasingMode="EaseOut" />
    <x:Double x:Key="ResponsiveStandardMinimumWidth">1180</x:Double>
    <x:Double x:Key="ResponsiveStandardMinimumHeight">650</x:Double>
    <x:Double x:Key="ResponsiveCompactMinimumWidth">800</x:Double>
    <x:Double x:Key="ResponsiveCompactMinimumHeight">500</x:Double>
    <x:Double x:Key="ResponsiveStressMinimumWidth">640</x:Double>
    <x:Double x:Key="ResponsiveStressMinimumHeight">360</x:Double>

    <!-- Component geometry composes approved primitives into property-specific values. -->
    <Thickness x:Key="ActionButtonPadding">16,0</Thickness>
    <Thickness x:Key="TextFieldContentPadding">10,13,6,13</Thickness>
    <Thickness x:Key="StatusContentPadding">16</Thickness>
    <Thickness x:Key="ToastContentPadding">16,12</Thickness>
    <Thickness x:Key="AppHeaderPadding">48,0</Thickness>
    <Thickness x:Key="EventCardPadding">22</Thickness>
    <Thickness x:Key="ModalDialogPadding">24</Thickness>
    <Thickness x:Key="CaptureGuideMargin">12</Thickness>
    <Thickness x:Key="DirtyIndicatorMargin">1</Thickness>
    <Thickness x:Key="SetupScrollContentPadding">0,0,20,0</Thickness>
    <Thickness x:Key="StrokeNone">0</Thickness>
    <Thickness x:Key="CameraMediaBadgePadding">9,7</Thickness>
    <Thickness x:Key="DialogEventIdentityPadding">0,16</Thickness>
    <Thickness x:Key="DialogEventIdentityStressPadding">0,12</Thickness>
    <Thickness x:Key="DialogSemanticIconStroke">2</Thickness>
    <x:Double x:Key="HairlineHeight">1</x:Double>
    <x:Double x:Key="SpaceStackCompact">4</x:Double>
    <x:Double x:Key="CameraMediaBadgeFontSize">10</x:Double>
    <x:Int32 x:Key="CameraMediaBadgeCharacterSpacing">100</x:Int32>
    <x:Double x:Key="DialogContentSpacing">14</x:Double>
    <x:Double x:Key="DialogSemanticIconSize">48</x:Double>
    <CornerRadius x:Key="DialogSemanticIconRadius">24</CornerRadius>
    <x:Double x:Key="DialogSemanticIconGlyphSize">22</x:Double>
    <x:Double x:Key="EventCardMetadataFontSize">12</x:Double>
    <x:Double x:Key="EventCardStatusSpacing">9</x:Double>
    <x:Double x:Key="EventCardStatusIconSize">18</x:Double>
    <x:Double x:Key="EventCardStatusFontSize">13</x:Double>
    <!-- Approved Modal Dialog contract dimensions (500 px decision, 440 px acknowledgement). -->
    <x:Double x:Key="ModalDialogMaximumWidth">500</x:Double>
    <x:Double x:Key="ModalAcknowledgementMaximumWidth">440</x:Double>

    <!-- Native families keep the platform's CommonStates and FocusStates templates. -->
    <Style x:Key="FotoHavnActionButtonPrimaryStyle" TargetType="Button">
        <Setter Property="MinHeight" Value="49" />
        <Setter Property="Padding" Value="{StaticResource ActionButtonPadding}" />
        <Setter Property="Background" Value="{ThemeResource ColorActionPrimaryIdleBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource ColorActionPrimaryIdleBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource StrokeDefault}" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
        <Setter Property="Foreground" Value="{ThemeResource ColorActionPrimaryForegroundBrush}" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualMargin" Value="{StaticResource FocusRingGap}" />
        <Setter Property="FocusVisualPrimaryThickness" Value="{StaticResource FocusRingThickness}" />
        <Setter Property="controls:ActionButtonVisuals.Emphasis" Value="Primary" />
    </Style>
    <Style x:Key="FotoHavnActionButtonSecondaryStyle" TargetType="Button">
        <Setter Property="MinHeight" Value="49" />
        <Setter Property="Padding" Value="{StaticResource ActionButtonPadding}" />
        <Setter Property="Background" Value="{ThemeResource ColorActionSecondaryIdleBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource ColorActionSecondaryBorderBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource StrokeDefault}" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
        <Setter Property="Foreground" Value="{ThemeResource ColorActionSecondaryForegroundBrush}" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualPrimaryThickness" Value="{StaticResource FocusRingThickness}" />
        <Setter Property="controls:ActionButtonVisuals.Emphasis" Value="Secondary" />
    </Style>
    <Style x:Key="FotoHavnActionButtonTertiaryStyle" TargetType="Button">
        <Setter Property="MinHeight" Value="{StaticResource TargetOperatorMinimum}" />
        <Setter Property="Padding" Value="{StaticResource ActionButtonPadding}" />
        <Setter Property="Background" Value="{ThemeResource ColorActionTertiaryIdleBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource ColorActionTertiaryForegroundBrush}" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualPrimaryThickness" Value="{StaticResource FocusRingThickness}" />
        <Setter Property="controls:ActionButtonVisuals.Emphasis" Value="Tertiary" />
    </Style>
    <Style x:Key="FotoHavnActionButtonDestructiveStyle" TargetType="Button" BasedOn="{StaticResource FotoHavnActionButtonPrimaryStyle}">
        <Setter Property="Background" Value="{ThemeResource ColorActionDestructiveIdleBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource ColorActionDestructiveIdleBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource ColorActionDestructiveForegroundBrush}" />
        <Setter Property="controls:ActionButtonVisuals.Emphasis" Value="Destructive" />
    </Style>
    <Style x:Key="FotoHavnActionButtonGuestProminentStyle" TargetType="Button" BasedOn="{StaticResource FotoHavnActionButtonPrimaryStyle}">
        <Setter Property="MinHeight" Value="{StaticResource TargetGuestProminent}" />
    </Style>
    <Style x:Key="FotoHavnIconActionStyle" TargetType="Button" BasedOn="{StaticResource FotoHavnActionButtonSecondaryStyle}">
        <Setter Property="MinWidth" Value="49" />
        <Setter Property="Width" Value="49" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style x:Key="FotoHavnIconActionDestructiveStyle" TargetType="Button" BasedOn="{StaticResource FotoHavnIconActionStyle}">
        <Setter Property="Foreground" Value="{ThemeResource ColorActionDestructiveIdleBrush}" />
    </Style>
    <Style x:Key="FotoHavnTextFieldStyle" TargetType="TextBox">
        <Setter Property="MinHeight" Value="{StaticResource TargetOperatorMinimum}" />
        <Setter Property="Padding" Value="{StaticResource TextFieldContentPadding}" />
        <Setter Property="BorderBrush" Value="{ThemeResource ColorBorderDefaultBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualPrimaryThickness" Value="{StaticResource FocusRingThickness}" />
    </Style>
    <Style x:Key="FotoHavnSelectFieldStyle" TargetType="ComboBox">
        <Setter Property="MinHeight" Value="{StaticResource TargetOperatorMinimum}" />
        <Setter Property="BorderBrush" Value="{ThemeResource ColorBorderDefaultBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualPrimaryThickness" Value="{StaticResource FocusRingThickness}" />
    </Style>
    <Style x:Key="FotoHavnReadOnlyValueStyle" TargetType="TextBlock" BasedOn="{StaticResource TypeBodyDefaultStyle}">
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="FotoHavnInlineStatusStyle" TargetType="controls:InlineStatus">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style x:Key="FotoHavnStatusCalloutStyle" TargetType="controls:StatusCallout">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style x:Key="FotoHavnProgressRingStyle" TargetType="ProgressRing">
        <Setter Property="Width" Value="{StaticResource IconDefault}" />
        <Setter Property="Height" Value="{StaticResource IconDefault}" />
        <Setter Property="IsTabStop" Value="False" />
    </Style>
    <!-- The 4 px determinate track is the Progress Indicator contract's optical exception. -->
    <Style x:Key="FotoHavnProgressBarStyle" TargetType="ProgressBar">
        <Setter Property="MinHeight" Value="4" />
        <Setter Property="IsTabStop" Value="False" />
    </Style>
    <Style x:Key="FotoHavnToastStyle" TargetType="controls:InAppToast">
        <Setter Property="MaxWidth" Value="{StaticResource ModalAcknowledgementMaximumWidth}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style x:Key="FotoHavnModalDialogStyle" TargetType="ContentDialog">
        <Setter Property="MaxWidth" Value="{StaticResource ModalDialogMaximumWidth}" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusDialog}" />
        <Setter Property="Shadow" Value="{StaticResource ElevationDialogThemeShadow}" />
        <Setter Property="PrimaryButtonStyle" Value="{StaticResource FotoHavnActionButtonPrimaryStyle}" />
        <Setter Property="SecondaryButtonStyle" Value="{StaticResource FotoHavnActionButtonSecondaryStyle}" />
    </Style>

    <!-- Operator component families introduced by rollout batch 3. -->
    <Style x:Key="FotoHavnAppHeaderStyle" TargetType="Border">
        <Setter Property="Height" Value="54" />
        <Setter Property="Padding" Value="{StaticResource AppHeaderPadding}" />
        <Setter Property="Background" Value="{ThemeResource ColorSurfacePanelBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource ColorBorderDefaultBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>
    <Style x:Key="FotoHavnBrandMarkStyle" TargetType="Border">
        <Setter Property="Width" Value="22" />
        <Setter Property="Height" Value="22" />
        <Setter Property="Background" Value="{ThemeResource ColorActionPrimaryIdleBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
    </Style>
    <Style x:Key="FotoHavnEventCardStyle" TargetType="controls:EventCard">
        <Setter Property="MinWidth" Value="280" />
        <Setter Property="Height" Value="256" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style x:Key="FotoHavnEventCardPanelStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource ColorSurfacePanelBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource ColorBorderDefaultBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource StrokeDefault}" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusPanel}" />
    </Style>
    <Style x:Key="FotoHavnSetupFieldGroupStyle" TargetType="controls:SetupFieldGroup">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style x:Key="FotoHavnDirtyIndicatorStyle" TargetType="Border">
        <Setter Property="Width" Value="3" />
        <Setter Property="Margin" Value="{StaticResource DirtyIndicatorMargin}" />
        <Setter Property="CornerRadius" Value="3,0,0,3" />
    </Style>
    <Style x:Key="FotoHavnCameraViewportStyle" TargetType="controls:CameraViewport">
        <Setter Property="Width" Value="588" />
        <Setter Property="Height" Value="330.75" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style x:Key="FotoHavnCameraViewportPanelStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource ColorTextPrimaryBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusPanel}" />
    </Style>
    <Style x:Key="FotoHavnCaptureGuideStyle" TargetType="Border">
        <Setter Property="Margin" Value="{StaticResource CaptureGuideMargin}" />
        <Setter Property="BorderBrush" Value="{ThemeResource ColorActionPrimaryForegroundBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource StrokeEmphasis}" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
        <Setter Property="Opacity" Value="0.82" />
    </Style>
    <!-- Compatibility aliases for surfaces migrating in later rollout batches. -->
    <SolidColorBrush x:Key="CanvasBrush" Color="#FFF5F6F7" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FF17181A" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#FF686B70" />
    <SolidColorBrush x:Key="HairlineBrush" Color="#FFD5D8DC" />
    <SolidColorBrush x:Key="FocusVisualPrimaryBrush" Color="#FF2458D3" />
    <SolidColorBrush x:Key="FocusVisualSecondaryBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="DangerBrush" Color="#FFD4382E" />
    <SolidColorBrush x:Key="EventHoverBrush" Color="#FFFAFAFB" />
    <Duration x:Key="FotoHavnStandardMotionDuration">0:0:0</Duration>
    <Duration x:Key="FotoHavnPreviewFadeDuration">0:0:0</Duration>
</ResourceDictionary>
