<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.22000.0</TargetPlatformMinVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace>FotoHavn.App</RootNamespace>
    <AssemblyName>FotoHAVN</AssemblyName>
    <DefineConstants>DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <Version>0.1.0-fieldtest.1</Version>
  </PropertyGroup>
  <PropertyGroup Condition="'$(UiVerificationBuild)' == 'true'">
    <DefineConstants>$(DefineConstants);UI_VERIFICATION</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.4.0" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.3.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../FotoHavn.Core/FotoHavn.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Update="Assets\Fonts\**\*" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="UiVerification\**\*.cs" />
    <None Include="UiVerification\ApprovedInjectionCatalog.json" />
  </ItemGroup>
  <ItemGroup Condition="'$(UiVerificationBuild)' == 'true'">
    <Compile Include="UiVerification\**\*.cs" />
    <Content Include="UiVerification\ApprovedInjectionCatalog.json"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <None Remove="UiVerification\ApprovedInjectionCatalog.json" />
  </ItemGroup>
  <Target Name="RejectUiVerificationFieldTestPublish"
          BeforeTargets="PrepareForPublish"
          Condition="'$(UiVerificationBuild)' == 'true' and '$(PublishProfile)' == 'FieldTest-win-x64'">
    <Error Text="The field-test profile cannot publish a UI verification build." />
  </Target>
  <Target Name="IncludeWinUIResourcesInPublish" AfterTargets="ComputeFilesToPublish">
    <ItemGroup>
      <_WinUIXbf Include="$(TargetDir)**\*.xbf" />
      <ResolvedFileToPublish Include="@(_WinUIXbf)">
        <RelativePath>%(_WinUIXbf.RecursiveDir)%(_WinUIXbf.Filename)%(_WinUIXbf.Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
      <ResolvedFileToPublish Include="$(TargetDir)$(AssemblyName).pri">
        <RelativePath>$(AssemblyName).pri</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
