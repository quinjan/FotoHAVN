<Window
    x:Class="FotoHavn.CameraRigPrototype.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="PROTOTYPE — FotoHAVN Windows camera rig probe">

  <Grid Padding="20" ColumnSpacing="20" Background="#111318">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="2*" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <Grid Grid.Column="0" RowSpacing="12">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <TextBlock Text="PROTOTYPE — Windows camera rig probe"
                 FontSize="24" FontWeight="SemiBold" Foreground="White" />

      <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
        <ComboBox x:Name="CameraPicker" Width="360"
                  PlaceholderText="Choose a Windows video-capture device"
                  DisplayMemberPath="Name"
                  SelectionChanged="CameraPicker_SelectionChanged" />
        <Button Content="Refresh" Click="Refresh_Click" />
        <Button x:Name="InitializeButton" Content="Initialize" Click="Initialize_Click" />
        <Button x:Name="CaptureButton" Content="Capture 4" Click="Capture_Click" IsEnabled="False" />
      </StackPanel>

      <Border Grid.Row="2" Background="Black" CornerRadius="4">
        <Grid>
          <Image x:Name="PreviewImage" Stretch="UniformToFill" RenderTransformOrigin="0.5,0.5">
            <Image.RenderTransform>
              <ScaleTransform ScaleX="-1" />
            </Image.RenderTransform>
          </Image>
          <TextBlock x:Name="PreviewLabel" Text="No preview"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     Foreground="#AAB2C0" FontSize="18" />
          <Border HorizontalAlignment="Left" VerticalAlignment="Top"
                  Margin="12" Padding="8,4" Background="#CC171A21" CornerRadius="3">
            <TextBlock Text="MIRRORED PREVIEW ONLY — saved Captures are unmirrored"
                       Foreground="White" FontSize="12" />
          </Border>
        </Grid>
      </Border>

      <TextBlock Grid.Row="3" Text="Minimum: preview ≥640×480 @15 fps; photo ≥1280×720. Four JPEGs are saved in evidence/."
                 Foreground="#AAB2C0" TextWrapping="Wrap" />
    </Grid>

    <Grid Grid.Column="1" RowSpacing="10">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <TextBlock Text="Current state" FontSize="18" FontWeight="SemiBold" Foreground="White" />
      <TextBlock x:Name="StateText" Grid.Row="1" FontFamily="Consolas"
                 Foreground="#D7DCE5" TextWrapping="Wrap" />

      <StackPanel Grid.Row="2">
        <TextBlock Text="Observed capabilities" Margin="0,8,0,6"
                   FontSize="16" FontWeight="SemiBold" Foreground="White" />
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <TextBlock x:Name="CapabilitiesText" FontFamily="Consolas" FontSize="12"
                     Foreground="#B7C0CF" TextWrapping="Wrap" />
        </ScrollViewer>
      </StackPanel>

      <StackPanel Grid.Row="3">
        <TextBlock Text="Device and capture events" Margin="0,8,0,6"
                   FontSize="16" FontWeight="SemiBold" Foreground="White" />
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <TextBlock x:Name="EventsText" FontFamily="Consolas" FontSize="12"
                     Foreground="#B7C0CF" TextWrapping="Wrap" />
        </ScrollViewer>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
